---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import MarqueeBrands from "../components/MarqueeBrands.astro";
import Case3D from "../components/Case3D.astro";
import PortfolioNiches from "../components/PortfolioNiches.astro";
import FilmRollGallery from "../components/FilmRollGallery.astro";
import ServicesSection from "../components/ServicesSection.astro";
import AboutSection from "../components/AboutSection.astro";
import Testimonials from "../components/Testimonials.astro";
import BudgetInquiry from "../components/BudgetInquiry.astro";
import Footer from "../components/Footer.astro";
import LeadMagnet from "../components/LeadMagnet.astro";
---

<Layout>
  <Header />
  <main id="conteudo-principal">
    <Hero />
    <MarqueeBrands />
    <Case3D />
    <PortfolioNiches />
    <FilmRollGallery />
    <ServicesSection />
    <AboutSection />
    <Testimonials />
    <BudgetInquiry />
  </main>
  <Footer />
  <LeadMagnet />
</Layout>
