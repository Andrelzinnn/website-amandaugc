---
import { portfolioData } from "../data/portfolioData";
import generalData from "../content/general.json";
import topbarData from "../content/topbar.json";
import heroData from "../content/hero.json";

// Modular Admin Components
import AdminHeader from "../components/admin/AdminHeader.astro";
import AdminTabsNav from "../components/admin/AdminTabsNav.astro";
import AdminBottomBar from "../components/admin/AdminBottomBar.astro";
import AdminCanvas from "../components/admin/AdminCanvas.astro";

// Modular Panes
import TopbarPane from "../components/admin/panes/TopbarPane.astro";
import HeroPane from "../components/admin/panes/HeroPane.astro";
import BrandsPane from "../components/admin/panes/BrandsPane.astro";
import CasesPane from "../components/admin/panes/CasesPane.astro";
import ServicesPane from "../components/admin/panes/ServicesPane.astro";
import TestimonialsPane from "../components/admin/panes/TestimonialsPane.astro";
import ContactPane from "../components/admin/panes/ContactPane.astro";
import ThemePane from "../components/admin/panes/ThemePane.astro";

// Dynamic collections import
const serviceModules = import.meta.glob<{ default: any }>("../content/services/*.json", { eager: true });
const brandModules = import.meta.glob<{ default: any }>("../content/brands/*.json", { eager: true });
const testimonialModules = import.meta.glob<{ default: any }>("../content/testimonials/*.json", { eager: true });
const caseModules = import.meta.glob<{ default: any }>("../content/cases/*.json", { eager: true });

const servicesList = Object.entries(serviceModules).map(([file, mod]) => ({
  path: file.replace("../", "src/"),
  data: mod.default || mod,
})).sort((a, b) => (a.data.step || "00").localeCompare(b.data.step || "00"));

const brandsList = Object.entries(brandModules).map(([file, mod]) => ({
  path: file.replace("../", "src/"),
  data: mod.default || mod,
})).sort((a, b) => (a.data.name || "").localeCompare(b.data.name || ""));

const testimonialsList = Object.entries(testimonialModules).map(([file, mod]) => ({
  path: file.replace("../", "src/"),
  data: mod.default || mod,
}));

const casesList = Object.entries(caseModules).map(([file, mod]) => ({
  path: file.replace("../", "src/"),
  data: mod.default || mod,
}));

const currentTheme = generalData.theme || portfolioData.theme || "terracotta";

const palettes = [
  {
    id: "terracotta",
    name: "Terracota & Dourado",
    subtitle: "Editorial Quente & Sofisticado",
    color1: "#A8382B",
    color2: "#C28D3F",
  },
  {
    id: "rose",
    name: "Rosa Nude & Champagne",
    subtitle: "Delicado · Skincare, Beleza & Glow",
    color1: "#C4556C",
    color2: "#D4A373",
  },
  {
    id: "monochrome",
    name: "Preto & Branco Editorial",
    subtitle: "Minimalista · Moda High-End & Luxo",
    color1: "#1B1815",
    color2: "#737373",
  },
  {
    id: "olive",
    name: "Verde Oliva & Sage",
    subtitle: "Natural · Orgânicos, Saúde & Bem-Estar",
    color1: "#3A5A40",
    color2: "#A3B18A",
  },
  {
    id: "mocha",
    name: "Marrom Mocha & Caramelo",
    subtitle: "Aconchegante · Lifestyle & Casa",
    color1: "#7B4B32",
    color2: "#C49A6C",
  },
];

const allCollections = [...servicesList, ...brandsList, ...casesList, ...testimonialsList];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Studio Admin & Live Preview | Amanda Lopes</title>
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎨</text></svg>"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Fraunces:opsz,wght@9..144,700&display=swap"
      rel="stylesheet"
    />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style>
      html, body {
        height: 100%;
        width: 100%;
        overflow: hidden;
        margin: 0;
        padding: 0;
      }
      body {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      }
      .font-serif-editorial {
        font-family: 'Fraunces', serif;
      }
      .no-scrollbar::-webkit-scrollbar {
        display: none;
      }
      .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
      ::-webkit-scrollbar {
        width: 6px;
        height: 6px;
      }
      ::-webkit-scrollbar-track {
        background: #171412;
      }
      ::-webkit-scrollbar-thumb {
        background: #3D3630;
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #C28D3F;
      }
      @media (max-width: 768px) {
        input[type="text"],
        input[type="number"],
        input[type="url"],
        textarea,
        select {
          font-size: 16px !important;
        }
      }
    </style>
  </head>
  <body class="bg-[#12100E] text-[#FAF8F5] min-h-screen flex flex-col antialiased selection:bg-[#A8382B] selection:text-white overflow-hidden">
    <!-- Top Studio Header -->
    <AdminHeader />

    <!-- Main Workspace: Split View with Resizable Splitter on Desktop, Full View on Mobile/Tablet via Toggle -->
    <div class="flex-1 flex flex-col lg:flex-row overflow-hidden relative" id="workspace-container">
      
      <!-- Left Sidebar: Visual Theme & Quick Settings -->
      <aside id="admin-sidebar" class="w-full lg:w-[410px] border-b lg:border-b-0 border-[#2D2824] bg-[#1B1815] flex flex-col flex-shrink-0 h-full relative overflow-hidden select-none">
        
        <!-- Modular Studio Navigation Tabs with Scroll Buttons -->
        <AdminTabsNav />

        <!-- Scrollable Panels Container (Cards scroll smoothly here) -->
        <div id="panels-container" class="flex-1 overflow-y-auto">
          <!-- TAB PANEL 1: Aviso Topo -->
          <TopbarPane topbarData={topbarData} />

          <!-- TAB PANEL 2: Início / Proposta de Valor -->
          <HeroPane heroData={heroData} />

          <!-- TAB PANEL 3: Marcas Parceiras -->
          <BrandsPane generalData={generalData} brandsList={brandsList} />

          <!-- TAB PANEL 4: Cases em Destaque -->
          <CasesPane casesList={casesList} />

          <!-- TAB PANEL 5: Formatos de Trabalho -->
          <ServicesPane servicesList={servicesList} />

          <!-- TAB PANEL 6: Depoimentos de Clientes -->
          <TestimonialsPane testimonialsList={testimonialsList} />

          <!-- TAB PANEL 7: Canais de Contato & Redes -->
          <ContactPane generalData={generalData} />

          <!-- TAB PANEL 8: Paleta de Cores -->
          <ThemePane palettes={palettes} currentTheme={currentTheme} />
        </div>

        <!-- Sticky Bottom Save Area -->
        <AdminBottomBar />
      </aside>

      <!-- Right Main: Live Preview Frame with Resizable Width Handle -->
      <AdminCanvas currentTheme={currentTheme} />
    </div>

    <!-- Client-Side Script with Solid State Management -->
    <script>
      import { initAdminStudio } from "../lib/admin";
      initAdminStudio();
    </script>

    <!-- Global State Injection for Hydration -->
    <script define:vars={{
      generalData,
      topbarData,
      heroData,
      allCollections
    }}>
      window.__INITIAL_GENERAL__ = generalData;
      window.__INITIAL_TOPBAR__ = topbarData;
      window.__INITIAL_HERO__ = heroData;
      window.__COLLECTIONS__ = allCollections;
    </script>
  </body>
</html>
