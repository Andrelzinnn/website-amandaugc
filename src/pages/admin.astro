---
import { portfolioData } from "../data/portfolioData";
import EditorIcon from "../components/icons/EditorIcon.astro";
import generalData from "../content/general.json";
import topbarData from "../content/topbar.json";
import heroData from "../content/hero.json";

// Dynamic collections import
const serviceModules = import.meta.glob<{ default: any }>("../content/services/*.json", { eager: true });
const brandModules = import.meta.glob<{ default: any }>("../content/brands/*.json", { eager: true });
const testimonialModules = import.meta.glob<{ default: any }>("../content/testimonials/*.json", { eager: true });
const caseModules = import.meta.glob<{ default: any }>("../content/cases/*.json", { eager: true });

const servicesList = Object.entries(serviceModules).map(([file, mod]) => ({
  path: file.replace("../", "src/"),
  data: mod.default || mod,
})).sort((a, b) => (a.data.step || "00").localeCompare(b.data.step || "00"));

const brandsList = Object.entries(brandModules).map(([file, mod]) => ({
  path: file.replace("../", "src/"),
  data: mod.default || mod,
})).sort((a, b) => (a.data.name || "").localeCompare(b.data.name || ""));

const testimonialsList = Object.entries(testimonialModules).map(([file, mod]) => ({
  path: file.replace("../", "src/"),
  data: mod.default || mod,
}));

const casesList = Object.entries(caseModules).map(([file, mod]) => ({
  path: file.replace("../", "src/"),
  data: mod.default || mod,
}));

const currentTheme = generalData.theme || portfolioData.theme || "terracotta";

const palettes = [
  {
    id: "terracotta",
    name: "Terracota & Dourado",
    subtitle: "Editorial Quente & Sofisticado",
    color1: "#A8382B",
    color2: "#C28D3F",
  },
  {
    id: "rose",
    name: "Rosa Nude & Champagne",
    subtitle: "Delicado · Skincare, Beleza & Glow",
    color1: "#C4556C",
    color2: "#D4A373",
  },
  {
    id: "monochrome",
    name: "Preto & Branco Editorial",
    subtitle: "Minimalista · Moda High-End & Luxo",
    color1: "#1B1815",
    color2: "#737373",
  },
  {
    id: "olive",
    name: "Verde Oliva & Sage",
    subtitle: "Natural · Orgânicos, Saúde & Bem-Estar",
    color1: "#3A5A40",
    color2: "#A3B18A",
  },
  {
    id: "mocha",
    name: "Marrom Mocha & Caramelo",
    subtitle: "Aconchegante · Lifestyle & Casa",
    color1: "#7B4B32",
    color2: "#C49A6C",
  },
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Studio Admin & Live Preview | Amanda Lopes</title>
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎨</text></svg>"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Fraunces:opsz,wght@9..144,700&display=swap"
      rel="stylesheet"
    />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style>
      html, body {
        height: 100%;
        width: 100%;
        overflow: hidden;
        margin: 0;
        padding: 0;
      }
      body {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      }
      .font-serif-editorial {
        font-family: 'Fraunces', serif;
      }
      .no-scrollbar::-webkit-scrollbar {
        display: none;
      }
      .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
      /* Custom modern scrollbars */
      ::-webkit-scrollbar {
        width: 6px;
        height: 6px;
      }
      ::-webkit-scrollbar-track {
        background: #171412;
      }
      ::-webkit-scrollbar-thumb {
        background: #3D3630;
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #C28D3F;
      }
      /* Previne zoom automático indesejado no Safari iOS (inputs < 16px acionam auto-zoom) */
      @media (max-width: 768px) {
        input[type="text"],
        input[type="number"],
        input[type="url"],
        textarea,
        select {
          font-size: 16px !important;
        }
      }
    </style>
  </head>
  <body class="bg-[#12100E] text-[#FAF8F5] min-h-screen flex flex-col antialiased selection:bg-[#A8382B] selection:text-white overflow-hidden">
    <!-- Top Studio Header -->
    <header class="h-14 border-b border-[#2D2824] bg-[#1B1815] px-3 sm:px-6 flex items-center justify-between z-30 flex-shrink-0 gap-2">
      <div class="flex items-center gap-2 sm:gap-3 flex-shrink-0">
        <a href="/" class="flex items-center gap-2 group">
          <span class="w-8 h-8 rounded-lg bg-[#A8382B] text-white flex items-center justify-center font-bold text-sm shadow-md">
            AL
          </span>
          <span class="font-serif-editorial font-bold text-base tracking-tight text-white hidden sm:inline">
            Amanda Lopes
          </span>
        </a>
        <span class="text-xs px-2.5 py-0.5 rounded-full bg-[#24201C] text-[#C4BDB5] border border-[#2D2824] font-semibold tracking-wider uppercase text-[10px] hidden md:inline-flex">
          Studio Admin
        </span>
      </div>

      <!-- Mobile / Tablet View Switcher Toggle (Visible only below lg) -->
      <div class="flex lg:hidden items-center bg-[#12100E] p-0.5 rounded-xl border border-[#2D2824]" id="mobile-view-toggle">
        <button
          type="button"
          id="mobile-tab-editor"
          class="mobile-view-btn active px-3 py-1.5 rounded-lg text-xs font-bold flex items-center gap-1.5 transition cursor-pointer bg-[#2D2824] text-white border border-[#3D3630]"
          data-view="editor"
        >
          <EditorIcon name="pencil" class="w-3.5 h-3.5 text-[#C28D3F]" />
          <span>Editor</span>
        </button>
        <button
          type="button"
          id="mobile-tab-preview"
          class="mobile-view-btn px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition cursor-pointer text-[#9E968E] hover:text-white border border-transparent"
          data-view="preview"
        >
          <EditorIcon name="eye" class="w-3.5 h-3.5" />
          <span>Prévia</span>
          <span id="mobile-preview-badge" class="w-2 h-2 rounded-full bg-[#A8382B] hidden"></span>
        </button>
      </div>

      <!-- Device View Controls (Desktop, Laptop 1024, Tablet 768, Mobile 390) - Only visible on Desktop (lg:) -->
      <div class="hidden lg:flex items-center gap-1 bg-[#12100E] p-1 rounded-xl border border-[#2D2824]">
        <button
          type="button"
          class="device-btn active px-2.5 py-1 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition cursor-pointer bg-[#2D2824] text-white border border-[#3D3630]"
          data-width="100%"
          title="Desktop Fluido (100%)"
        >
          <EditorIcon name="desktop" class="w-3.5 h-3.5" />
          <span class="hidden md:inline">Desktop</span>
        </button>
        <button
          type="button"
          class="device-btn px-2.5 py-1 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition cursor-pointer text-[#9E968E] hover:text-white hover:bg-[#1B1815] border border-transparent"
          data-width="1024px"
          title="Laptop / Notebook (1024px)"
        >
          <EditorIcon name="desktop" class="w-3.5 h-3.5" />
          <span class="hidden md:inline">1024px</span>
        </button>
        <button
          type="button"
          class="device-btn px-2.5 py-1 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition cursor-pointer text-[#9E968E] hover:text-white hover:bg-[#1B1815] border border-transparent"
          data-width="768px"
          title="Tablet / iPad (768px)"
        >
          <EditorIcon name="phone" class="w-3.5 h-3.5" />
          <span class="hidden md:inline">Tablet</span>
        </button>
        <button
          type="button"
          class="device-btn px-2.5 py-1 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition cursor-pointer text-[#9E968E] hover:text-white hover:bg-[#1B1815] border border-transparent"
          data-width="390px"
          title="Celular (iPhone 390px)"
        >
          <EditorIcon name="phone" class="w-3.5 h-3.5" />
          <span class="hidden md:inline">Celular</span>
        </button>
      </div>

      <!-- Action Links -->
      <div class="flex items-center gap-1.5 sm:gap-3 flex-shrink-0">
        <button
          type="button"
          id="btn-reload"
          class="p-2 rounded-lg bg-[#24201C] hover:bg-[#2D2824] text-[#C4BDB5] hover:text-white border border-[#2D2824] transition cursor-pointer text-xs flex items-center justify-center"
          title="Recarregar tela"
        >
          <EditorIcon name="refresh" class="w-3.5 h-3.5" />
        </button>

        <!-- Connected indicator badge in header -->
        <span
          id="header-auth-badge"
          style="display: none;"
          class="items-center gap-1.5 px-2.5 py-1.5 rounded-xl bg-[#171412] border border-emerald-900/60 text-emerald-400 text-xs font-semibold select-none hidden sm:inline-flex"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>Conectado</span>
        </span>

        <!-- Direct Login button if unauthenticated -->
        <button
          type="button"
          id="header-login-btn"
          style="display: none;"
          class="items-center gap-1.5 px-3 py-1.5 rounded-xl bg-[#A8382B] hover:bg-[#82271D] text-white text-xs font-bold uppercase tracking-wider transition shadow-lg cursor-pointer border border-[#C28D3F]/40"
          title="Fazer login no Studio para salvar alterações"
        >
          <EditorIcon name="lock" class="w-3.5 h-3.5 text-[#C28D3F]" />
          <span>Login</span>
        </button>

        <a
          href="/keystatic"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-2.5 sm:px-3 py-1.5 rounded-xl bg-[#24201C] hover:bg-[#2D2824] text-[#C4BDB5] hover:text-white border border-[#2D2824] text-xs font-medium transition cursor-pointer"
          title="Abrir painel Keystatic CMS em nova aba"
        >
          <span class="hidden sm:inline">CMS</span>
          <EditorIcon name="external-link" class="w-3 h-3" />
        </a>
      </div>
    </header>

    <!-- Main Workspace: Split View with Resizable Splitter on Desktop, Full View on Mobile/Tablet via Toggle -->
    <div class="flex-1 flex flex-col lg:flex-row overflow-hidden relative" id="workspace-container">
      
      <!-- Left Sidebar: Visual Theme & Quick Settings -->
      <aside id="admin-sidebar" class="w-full lg:w-[410px] border-b lg:border-b-0 border-[#2D2824] bg-[#1B1815] flex flex-col flex-shrink-0 h-full relative overflow-hidden select-none">
        
        <!-- Modular Studio Navigation Tabs with Scroll Buttons -->
        <div class="border-b border-[#2D2824] bg-[#171412] px-2 py-1.5 flex items-center gap-1 select-none flex-shrink-0 relative">
          <!-- Left scroll arrow -->
          <button
            type="button"
            id="tabs-scroll-left"
            class="w-6 h-7 rounded-lg bg-[#24201C] hover:bg-[#2D2824] text-[#9E968E] hover:text-white border border-[#2D2824] flex items-center justify-center flex-shrink-0 cursor-pointer text-xs transition"
            title="Rolar abas para esquerda"
          >
            ‹
          </button>

          <!-- Tabs scroll area -->
          <div id="tabs-scroll-container" class="flex-1 flex items-center gap-1 overflow-x-auto no-scrollbar scroll-smooth py-0.5">
            <button
              type="button"
              class="module-tab active px-3 py-1.5 rounded-xl text-xs font-semibold flex items-center gap-1.5 transition-all cursor-pointer bg-[#24201C] text-white border border-[#3D3630] whitespace-nowrap flex-shrink-0"
              data-tab="topbar"
              data-target-anchor="top"
            >
              <EditorIcon name="megaphone" class="w-3.5 h-3.5 text-[#C28D3F]" />
              <span>Aviso Topo</span>
            </button>
            <button
              type="button"
              class="module-tab px-3 py-1.5 rounded-xl text-xs font-semibold flex items-center gap-1.5 transition-all cursor-pointer text-[#9E968E] hover:text-white hover:bg-[#24201C] border border-transparent whitespace-nowrap flex-shrink-0"
              data-tab="hero"
              data-target-anchor="conteudo-principal"
            >
              <EditorIcon name="sparkle" class="w-3.5 h-3.5 text-[#C28D3F]" />
              <span>Hero & Métricas</span>
            </button>
            <button
              type="button"
              class="module-tab px-3 py-1.5 rounded-xl text-xs font-semibold flex items-center gap-1.5 transition-all cursor-pointer text-[#9E968E] hover:text-white hover:bg-[#24201C] border border-transparent whitespace-nowrap flex-shrink-0"
              data-tab="brands"
              data-target-anchor="marcas"
            >
              <EditorIcon name="sparkle" class="w-3.5 h-3.5 text-[#C28D3F]" />
              <span>Marcas</span>
            </button>
            <button
              type="button"
              class="module-tab px-3 py-1.5 rounded-xl text-xs font-semibold flex items-center gap-1.5 transition-all cursor-pointer text-[#9E968E] hover:text-white hover:bg-[#24201C] border border-transparent whitespace-nowrap flex-shrink-0"
              data-tab="cases"
              data-target-anchor="cases"
            >
              <EditorIcon name="video" class="w-3.5 h-3.5 text-[#C28D3F]" />
              <span>Cases 3D</span>
            </button>
            <button
              type="button"
              class="module-tab px-3 py-1.5 rounded-xl text-xs font-semibold flex items-center gap-1.5 transition-all cursor-pointer text-[#9E968E] hover:text-white hover:bg-[#24201C] border border-transparent whitespace-nowrap flex-shrink-0"
              data-tab="services"
              data-target-anchor="servicos"
            >
              <EditorIcon name="clapperboard" class="w-3.5 h-3.5 text-[#C28D3F]" />
              <span>Serviços</span>
            </button>
            <button
              type="button"
              class="module-tab px-3 py-1.5 rounded-xl text-xs font-semibold flex items-center gap-1.5 transition-all cursor-pointer text-[#9E968E] hover:text-white hover:bg-[#24201C] border border-transparent whitespace-nowrap flex-shrink-0"
              data-tab="testimonials"
              data-target-anchor="depoimentos"
            >
              <EditorIcon name="gift" class="w-3.5 h-3.5 text-[#C28D3F]" />
              <span>Depoimentos</span>
            </button>
            <button
              type="button"
              class="module-tab px-3 py-1.5 rounded-xl text-xs font-semibold flex items-center gap-1.5 transition-all cursor-pointer text-[#9E968E] hover:text-white hover:bg-[#24201C] border border-transparent whitespace-nowrap flex-shrink-0"
              data-tab="contact"
              data-target-anchor="contato"
            >
              <EditorIcon name="phone" class="w-3.5 h-3.5 text-[#C28D3F]" />
              <span>Contato</span>
            </button>
            <button
              type="button"
              class="module-tab px-3 py-1.5 rounded-xl text-xs font-semibold flex items-center gap-1.5 transition-all cursor-pointer text-[#9E968E] hover:text-white hover:bg-[#24201C] border border-transparent whitespace-nowrap flex-shrink-0"
              data-tab="theme"
            >
              <EditorIcon name="palette" class="w-3.5 h-3.5 text-[#C28D3F]" />
              <span>Cores</span>
            </button>
          </div>

          <!-- Right scroll arrow -->
          <button
            type="button"
            id="tabs-scroll-right"
            class="w-6 h-7 rounded-lg bg-[#24201C] hover:bg-[#2D2824] text-[#9E968E] hover:text-white border border-[#2D2824] flex items-center justify-center flex-shrink-0 cursor-pointer text-xs transition"
            title="Rolar abas para direita"
          >
            ›
          </button>
        </div>

        <!-- Unauthenticated Session Notice Banner -->
        <div id="auth-warning-banner" style="display: none;" class="m-3 p-3.5 rounded-xl bg-[#221C16] border border-amber-600/40 text-amber-100 flex-shrink-0">
          <div class="flex items-start gap-2.5">
            <span class="text-base select-none">🔒</span>
            <div class="flex-1 text-xs">
              <p class="font-bold text-amber-200">Modo de Pré-visualização</p>
              <p class="text-[11px] text-[#A89F95] mt-0.5 leading-relaxed">
                Você pode testar e pré-visualizar qualquer alteração em tempo real. Para salvar e publicar as edições no site, conecte sua conta.
              </p>
              <button
                type="button"
                id="banner-login-btn"
                class="mt-2.5 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#A8382B] hover:bg-[#82271D] text-white text-xs font-bold uppercase tracking-wider transition shadow cursor-pointer border border-[#C28D3F]/30"
              >
                <span>Conectar Conta / Fazer Login</span>
                <EditorIcon name="external-link" class="w-3 h-3" />
              </button>
            </div>
          </div>
        </div>

        <!-- Scrollable Panels Container (Cards scroll smoothly here) -->
        <div id="panels-container" class="flex-1 overflow-y-auto">

          <!-- TAB PANEL 1: Aviso Topo (Topbar) -->
          <div id="panel-topbar" class="tab-panel p-4 space-y-4">
            <div class="pb-2 border-b border-[#2D2824]">
              <h3 class="text-xs font-bold uppercase tracking-wider text-white">Barra de Aviso Superior</h3>
              <p class="text-[11px] text-[#9E968E] mt-0.5">Urgência, datas comemorativas e status de vagas.</p>
            </div>

            <!-- Presets Rápidos -->
            <div>
              <label class="block text-[10px] font-bold uppercase tracking-wider text-[#8A827B] mb-1.5">
                Sugestões Rápidas (1-Clique)
              </label>
              <div class="grid grid-cols-2 gap-1.5">
                <button
                  type="button"
                  class="topbar-preset-btn p-2 rounded-xl bg-[#24201C] hover:bg-[#2D2824] border border-[#2D2824] text-[10px] text-left text-[#E8E2D9] font-medium transition cursor-pointer"
                  data-badge="Vagas Abertas"
                  data-text="Recebendo projetos para as próximas semanas · Entrega em 5 a 7 dias úteis"
                  data-cta="Garantir data →"
                >
                  ✨ Vagas Abertas
                </button>
                <button
                  type="button"
                  class="topbar-preset-btn p-2 rounded-xl bg-[#24201C] hover:bg-[#2D2824] border border-[#2D2824] text-[10px] text-left text-[#E8E2D9] font-medium transition cursor-pointer"
                  data-badge="Black Friday 🔥"
                  data-text="Campanhas de Black Friday abertas · Vagas limitadas para criativos de alta conversão"
                  data-cta="Reservar Campanha →"
                >
                  🔥 Black Friday
                </button>
                <button
                  type="button"
                  class="topbar-preset-btn p-2 rounded-xl bg-[#24201C] hover:bg-[#2D2824] border border-[#2D2824] text-[10px] text-left text-[#E8E2D9] font-medium transition cursor-pointer"
                  data-badge="Dia das Mães 🌸"
                  data-text="Criativos para a campanha do Dia das Mães · Produção acelerada para Meta Ads"
                  data-cta="Solicitar Roteiros →"
                >
                  🌸 Dia das Mães
                </button>
                <button
                  type="button"
                  class="topbar-preset-btn p-2 rounded-xl bg-[#24201C] hover:bg-[#2D2824] border border-[#2D2824] text-[10px] text-left text-[#E8E2D9] font-medium transition cursor-pointer"
                  data-badge="Últimas Vagas ⚡"
                  data-text="Agenda do mês quase encerrada · Apenas 2 vagas para novos contratos"
                  data-cta="Garantir agora →"
                >
                  ⚡ Agenda Quase Cheia
                </button>
              </div>
            </div>

            <!-- Campos Form Topbar -->
            <div class="space-y-3">
              <div>
                <label for="input-topbar-badge" class="block text-[11px] font-bold text-white mb-1">
                  Selo / Destaque
                </label>
                <input
                  type="text"
                  id="input-topbar-badge"
                  value={topbarData.badge}
                  class="w-full px-3 py-2 rounded-xl bg-[#24201C] border border-[#2D2824] focus:border-[#A8382B] text-xs text-white placeholder-[#8A827B] focus:outline-none transition"
                  placeholder="Ex: Vagas Abertas"
                />
              </div>
              <div>
                <label for="input-topbar-text" class="block text-[11px] font-bold text-white mb-1">
                  Texto do Aviso
                </label>
                <textarea
                  id="input-topbar-text"
                  rows="2"
                  class="w-full px-3 py-2 rounded-xl bg-[#24201C] border border-[#2D2824] focus:border-[#A8382B] text-xs text-white placeholder-[#8A827B] focus:outline-none transition resize-none"
                  placeholder="Texto explicativo do banner..."
                >{topbarData.text}</textarea>
              </div>
              <div>
                <label for="input-topbar-cta" class="block text-[11px] font-bold text-white mb-1">
                  Texto do Link / Botão
                </label>
                <input
                  type="text"
                  id="input-topbar-cta"
                  value={topbarData.ctaText}
                  class="w-full px-3 py-2 rounded-xl bg-[#24201C] border border-[#2D2824] focus:border-[#A8382B] text-xs text-white placeholder-[#8A827B] focus:outline-none transition"
                  placeholder="Ex: Garantir data →"
                />
              </div>
            </div>
          </div>

          <!-- TAB PANEL 3: Hero & Métricas -->
          <div id="panel-hero" class="tab-panel hidden p-4 space-y-4">
            <div class="pb-2 border-b border-[#2D2824]">
              <h3 class="text-xs font-bold uppercase tracking-wider text-white">Início / Proposta de Valor</h3>
              <p class="text-[11px] text-[#9E968E] mt-0.5">Headline, subtítulo e números expressivos do Hero.</p>
            </div>
            <div class="space-y-3">
              <div>
                <label for="input-hero-headline" class="block text-[11px] font-bold text-white mb-1">
                  Título Principal (Caixa Alta)
                </label>
                <input
                  type="text"
                  id="input-hero-headline"
                  value={heroData.headline}
                  class="w-full px-3 py-2 rounded-xl bg-[#24201C] border border-[#2D2824] focus:border-[#A8382B] text-xs text-white placeholder-[#8A827B] focus:outline-none transition"
                />
              </div>
              <div>
                <label for="input-hero-cursive" class="block text-[11px] font-bold text-white mb-1">
                  Destaque Cursivo
                </label>
                <input
                  type="text"
                  id="input-hero-cursive"
                  value={heroData.headlineCursive}
                  class="w-full px-3 py-2 rounded-xl bg-[#24201C] border border-[#2D2824] focus:border-[#A8382B] text-xs text-white placeholder-[#8A827B] focus:outline-none transition"
                />
              </div>
              <div>
