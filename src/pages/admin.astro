---
import { portfolioData } from "../data/portfolioData";
import EditorIcon from "../components/icons/EditorIcon.astro";
import generalData from "../content/general.json";

const currentTheme = generalData.theme || portfolioData.theme || "terracotta";

const palettes = [
  {
    id: "terracotta",
    name: "Terracota & Dourado",
    subtitle: "Editorial Quente & Sofisticado",
    color1: "#A8382B",
    color2: "#C28D3F",
  },
  {
    id: "rose",
    name: "Rosa Nude & Champagne",
    subtitle: "Delicado · Skincare, Beleza & Glow",
    color1: "#C4556C",
    color2: "#D4A373",
  },
  {
    id: "monochrome",
    name: "Preto & Branco Editorial",
    subtitle: "Minimalista · Moda High-End & Luxo",
    color1: "#1B1815",
    color2: "#737373",
  },
  {
    id: "olive",
    name: "Verde Oliva & Sage",
    subtitle: "Natural · Orgânicos, Saúde & Bem-Estar",
    color1: "#3A5A40",
    color2: "#A3B18A",
  },
  {
    id: "mocha",
    name: "Marrom Mocha & Caramelo",
    subtitle: "Aconchegante · Lifestyle & Casa",
    color1: "#7B4B32",
    color2: "#C49A6C",
  },
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Studio Admin & Live Preview | Amanda Silveira</title>
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎨</text></svg>"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Fraunces:opsz,wght@9..144,700&display=swap"
      rel="stylesheet"
    />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style>
      body {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      }
      .font-serif-editorial {
        font-family: 'Fraunces', serif;
      }
    </style>
  </head>
  <body class="bg-[#12100E] text-[#FAF8F5] min-h-screen flex flex-col antialiased selection:bg-[#A8382B] selection:text-white">
    <!-- Top Studio Header -->
    <header class="h-14 border-b border-[#2D2824] bg-[#1B1815] px-4 sm:px-6 flex items-center justify-between z-20 flex-shrink-0">
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2 group">
          <span class="w-8 h-8 rounded-lg bg-[#A8382B] text-white flex items-center justify-center font-bold text-sm shadow-md">
            AS
          </span>
          <span class="font-serif-editorial font-bold text-base tracking-tight text-white hidden sm:inline">
            Amanda Silveira
          </span>
        </a>
        <span class="text-xs px-2.5 py-0.5 rounded-full bg-[#24201C] text-[#C4BDB5] border border-[#2D2824] font-semibold tracking-wider uppercase text-[10px]">
          Studio Admin & Live Preview
        </span>
      </div>

      <!-- Device View Controls -->
      <div class="flex items-center gap-1 bg-[#12100E] p-1 rounded-xl border border-[#2D2824]">
        <button
          type="button"
          id="btn-desktop"
          class="device-btn active px-3 py-1 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition cursor-pointer bg-[#2D2824] text-white border border-[#3D3630]"
          title="Visualizar em Desktop"
        >
          <EditorIcon name="desktop" class="w-3.5 h-3.5" />
          <span class="hidden md:inline">Desktop</span>
        </button>
        <button
          type="button"
          id="btn-mobile"
          class="device-btn px-3 py-1 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition cursor-pointer text-[#9E968E] hover:text-white hover:bg-[#1B1815] border border-transparent"
          title="Visualizar em Celular (iPhone)"
        >
          <EditorIcon name="phone" class="w-3.5 h-3.5" />
          <span class="hidden md:inline">Celular (Mobile)</span>
        </button>
      </div>

      <!-- Action Links -->
      <div class="flex items-center gap-2 sm:gap-3">
        <button
          type="button"
          id="btn-reload"
          class="p-2 rounded-lg bg-[#24201C] hover:bg-[#2D2824] text-[#C4BDB5] hover:text-white border border-[#2D2824] transition cursor-pointer text-xs flex items-center justify-center"
          title="Recarregar tela"
        >
          <EditorIcon name="refresh" class="w-3.5 h-3.5" />
        </button>
        <a
          href="/keystatic"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-[#A8382B] hover:bg-[#82271D] text-white text-xs font-bold uppercase tracking-wider transition shadow-lg cursor-pointer"
        >
          <span>Editor de Conteúdo</span>
          <EditorIcon name="external-link" class="w-3 h-3" />
        </a>
      </div>
    </header>

    <!-- Main Workspace: Split View -->
    <div class="flex-1 flex flex-col lg:flex-row overflow-hidden">
      <!-- Left Sidebar: Visual Theme & Quick Settings -->
      <aside class="w-full lg:w-96 border-b lg:border-b-0 lg:border-r border-[#2D2824] bg-[#1B1815] flex flex-col flex-shrink-0 overflow-y-auto max-h-72 lg:max-h-full">
        <!-- Palette Header -->
        <div class="p-5 border-b border-[#2D2824]">
          <div class="inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-widest text-[#C28D3F] mb-1">
            <EditorIcon name="sparkle" class="w-3.5 h-3.5 text-[#C28D3F]" />
            <span>Personalização Visual</span>
          </div>
          <h2 class="text-lg font-bold text-white">Paleta de Cores do Site</h2>
          <p class="text-xs text-[#9E968E] mt-1 leading-relaxed">
            Clique em qualquer paleta abaixo para pré-visualizar a mudança de cor no site ao vivo em tempo real.
          </p>
        </div>

        <!-- Color Swatch Cards -->
        <div class="p-4 space-y-2.5">
          {palettes.map((p) => {
            const isActive = p.id === currentTheme;
            return (
              <button
                type="button"
                class={`palette-card w-full text-left p-3.5 rounded-2xl border transition-all cursor-pointer flex items-center justify-between ${
                  isActive
                    ? "border-[#A8382B] bg-[#361A16] active-card"
                    : "border-[#2D2824] hover:border-[#3D3630] bg-[#24201C] hover:bg-[#2D2824]"
                }`}
                data-theme={p.id}
              >
                <div class="flex items-center gap-3">
                  <div class="flex items-center -space-x-1.5 flex-shrink-0">
                    <span
                      class="w-6 h-6 rounded-full border-2 border-[#1B1815] shadow-sm"
                      style={`background-color: ${p.color1};`}
                    ></span>
                    <span
                      class="w-6 h-6 rounded-full border-2 border-[#1B1815] shadow-sm"
                      style={`background-color: ${p.color2};`}
                    ></span>
                  </div>
                  <div>
                    <span class="block text-xs font-bold text-white">{p.name}</span>
                    <span class="block text-[10px] text-[#9E968E]">{p.subtitle}</span>
                  </div>
                </div>
                <span class={`check-icon text-xs text-[#A8382B] font-bold ${isActive ? "" : "hidden"}`}>
                  <EditorIcon name="check" class="w-3.5 h-3.5" />
                </span>
              </button>
            );
          })}
        </div>

        <!-- Action & Publish Box -->
        <div
          id="publish-card"
          class="p-4 mx-4 mb-4 rounded-2xl bg-[#24201C] border border-[#2D2824] flex flex-col gap-3"
          data-general={JSON.stringify(generalData)}
          data-saved-theme={currentTheme}
        >
          <!-- Connection Status Line -->
          <div class="flex items-center justify-between text-[11px]">
            <span class="text-[#9E968E] flex items-center gap-1.5 font-medium">
              <span id="auth-status-dot" class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span id="auth-status-text">Verificando conexão...</span>
            </span>
            <button
              type="button"
              id="btn-auth-action"
              class="hidden text-[#C28D3F] hover:text-white underline font-bold cursor-pointer transition text-[10px]"
            >
              Conectar
            </button>
          </div>

          <!-- Save Button -->
          <button
            type="button"
            id="btn-save-theme"
            disabled
            class="w-full py-2.5 px-4 rounded-xl bg-[#2D2824] text-[#8A827B] font-bold text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2 cursor-not-allowed border border-transparent select-none"
          >
            <span id="save-btn-icon">
              <EditorIcon name="check" class="w-3.5 h-3.5" />
            </span>
            <span id="save-btn-text">Paleta Atual Ativa</span>
          </button>

          <!-- Toast Message Feedback -->
          <div id="save-feedback" class="hidden text-center text-[11px] font-semibold py-1.5 px-2.5 rounded-lg transition-all"></div>
        </div>

        <!-- Quick Shortcuts -->
        <div class="mt-auto p-4 border-t border-[#2D2824]">
          <span class="text-[10px] font-bold uppercase tracking-wider text-[#8A827B] block mb-2">
            Atalhos Rápidos de Edição
          </span>
          <div class="grid grid-cols-2 gap-2 text-[11px]">
            <a href="/keystatic/branch/main/singleton/topbar" class="p-2 rounded-lg bg-[#24201C] hover:bg-[#2D2824] border border-[#2D2824] hover:border-[#3D3630] transition block font-medium text-[#E8E2D9]">
              <span class="flex items-center gap-1.5">
                <EditorIcon name="megaphone" class="w-3.5 h-3.5 text-[#C28D3F]" />
                <span>Aviso Topo</span>
              </span>
            </a>
            <a href="/keystatic/branch/main/collection/cases" class="p-2 rounded-lg bg-[#24201C] hover:bg-[#2D2824] border border-[#2D2824] hover:border-[#3D3630] transition block font-medium text-[#E8E2D9]">
              <span class="flex items-center gap-1.5">
                <EditorIcon name="clapperboard" class="w-3.5 h-3.5 text-[#C28D3F]" />
                <span>Cases 3D</span>
              </span>
            </a>
            <a href="/keystatic/branch/main/collection/portfolioVideos" class="p-2 rounded-lg bg-[#24201C] hover:bg-[#2D2824] border border-[#2D2824] hover:border-[#3D3630] transition block font-medium text-[#E8E2D9]">
              <span class="flex items-center gap-1.5">
                <EditorIcon name="video" class="w-3.5 h-3.5 text-[#C28D3F]" />
                <span>Vídeos Nichos</span>
              </span>
            </a>
            <a href="/keystatic/branch/main/collection/photos" class="p-2 rounded-lg bg-[#24201C] hover:bg-[#2D2824] border border-[#2D2824] hover:border-[#3D3630] transition block font-medium text-[#E8E2D9]">
              <span class="flex items-center gap-1.5">
                <EditorIcon name="camera" class="w-3.5 h-3.5 text-[#C28D3F]" />
                <span>Fotos UGC</span>
              </span>
            </a>
          </div>
        </div>
      </aside>

      <!-- Right Main: Live Website Preview Canvas -->
      <main class="flex-1 bg-[#0D0B0A] relative flex items-center justify-center p-2 sm:p-6 overflow-hidden">
        <!-- Frame Container -->
        <div
          id="preview-wrapper"
          class="w-full h-full transition-all duration-300 flex items-center justify-center"
        >
          <iframe
            id="site-iframe"
            data-initial-theme={currentTheme}
            src={`/?theme=${currentTheme}`}
            class="w-full h-full bg-[#FAF8F5] rounded-xl shadow-2xl transition-all duration-300 border-2 border-[#2D2824]"
            title="Pré-visualização do site"
          ></iframe>
        </div>
      </main>
    </div>

    <!-- Client-side script for interactive Studio live preview -->
    <script>
      import { getKeystaticAuth, saveContentFiles, redirectToLogin } from "../lib/keystaticClient";

      const iframe = document.getElementById("site-iframe") as HTMLIFrameElement;
      const wrapper = document.getElementById("preview-wrapper");
      const btnDesktop = document.getElementById("btn-desktop");
      const btnMobile = document.getElementById("btn-mobile");
      const btnReload = document.getElementById("btn-reload");
      const paletteCards = document.querySelectorAll(".palette-card");

      const publishCard = document.getElementById("publish-card");
      const authStatusDot = document.getElementById("auth-status-dot");
      const authStatusText = document.getElementById("auth-status-text");
      const btnAuthAction = document.getElementById("btn-auth-action");
      const btnSaveTheme = document.getElementById("btn-save-theme") as HTMLButtonElement;
      const saveBtnText = document.getElementById("save-btn-text");
      const saveFeedback = document.getElementById("save-feedback");

      let currentGeneralData = publishCard?.dataset.general ? JSON.parse(publishCard.dataset.general) : {};
      let savedTheme = publishCard?.dataset.savedTheme || "terracotta";
      let selectedTheme = savedTheme;

      // Check Authentication Status
      function updateAuthUI() {
        const auth = getKeystaticAuth();
        if (auth.isLocal) {
          if (authStatusDot) authStatusDot.className = "w-2 h-2 rounded-full bg-emerald-500";
          if (authStatusText) authStatusText.textContent = "Modo Local (Gravação Direta)";
          if (btnAuthAction) btnAuthAction.classList.add("hidden");
        } else if (auth.isAuthenticated) {
          if (authStatusDot) authStatusDot.className = "w-2 h-2 rounded-full bg-emerald-500";
          if (authStatusText) authStatusText.textContent = "Conectado ao Keystatic Cloud";
          if (btnAuthAction) btnAuthAction.classList.add("hidden");
        } else {
          if (authStatusDot) authStatusDot.className = "w-2 h-2 rounded-full bg-amber-500 animate-pulse";
          if (authStatusText) authStatusText.textContent = "Desconectado da Nuvem";
          if (btnAuthAction) {
            btnAuthAction.classList.remove("hidden");
            btnAuthAction.textContent = "Conectar";
            btnAuthAction.onclick = () => redirectToLogin();
          }
        }
      }

      updateAuthUI();

      // Update Save Button State
      function updateSaveButtonState() {
        if (!btnSaveTheme || !saveBtnText) return;
        const hasChanged = selectedTheme !== savedTheme;

        if (hasChanged) {
          btnSaveTheme.disabled = false;
          btnSaveTheme.className = "w-full py-2.5 px-4 rounded-xl bg-[#A8382B] hover:bg-[#82271D] text-white font-bold text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2 cursor-pointer shadow-lg shadow-[#A8382B]/20 border border-[#C28D3F]/40";
          saveBtnText.textContent = "Salvar e Publicar no Site";
        } else {
          btnSaveTheme.disabled = true;
          btnSaveTheme.className = "w-full py-2.5 px-4 rounded-xl bg-[#2D2824] text-[#8A827B] font-bold text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2 cursor-not-allowed border border-transparent select-none";
          saveBtnText.textContent = "Paleta Atual Ativa";
        }
      }

      // Palette Card Selection & Live Iframe Theme Update
      paletteCards.forEach((card) => {
        card.addEventListener("click", () => {
          const theme = card.getAttribute("data-theme") || "terracotta";
          selectedTheme = theme;

          paletteCards.forEach((c) => {
            c.classList.remove("border-[#A8382B]", "bg-[#361A16]", "active-card");
            c.classList.add("border-[#2D2824]", "bg-[#24201C]");
            const check = c.querySelector(".check-icon");
            if (check) check.classList.add("hidden");
          });

          card.classList.remove("border-[#2D2824]", "bg-[#24201C]");
          card.classList.add("border-[#A8382B]", "bg-[#361A16]", "active-card");
          const check = card.querySelector(".check-icon");
          if (check) check.classList.remove("hidden");

          updateSaveButtonState();

          // Directly message the iframe or update its location query
          if (iframe && iframe.contentWindow) {
            try {
              iframe.contentWindow.document.documentElement.setAttribute("data-theme", theme);
            } catch (e) {
              iframe.src = `/?theme=${theme}`;
            }
          }
        });
      });

      // Save Theme Handler
      btnSaveTheme?.addEventListener("click", async () => {
        if (selectedTheme === savedTheme) return;

        btnSaveTheme.disabled = true;
        btnSaveTheme.className = "w-full py-2.5 px-4 rounded-xl bg-[#2D2824] text-white font-bold text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2 cursor-wait border border-transparent";
        if (saveBtnText) saveBtnText.textContent = "Publicando no GitHub...";
        if (saveFeedback) saveFeedback.classList.add("hidden");

        const updatedGeneral = {
          ...currentGeneralData,
          theme: selectedTheme,
        };

        const result = await saveContentFiles({
          message: `Atualiza paleta de cores para ${selectedTheme}`,
          files: [
            {
              path: "src/content/general.json",
              contents: JSON.stringify(updatedGeneral, null, 2) + "\n",
            },
          ],
        });

        if (result.success) {
          savedTheme = selectedTheme;
          currentGeneralData = updatedGeneral;
          updateSaveButtonState();

          if (saveFeedback) {
            saveFeedback.className = "text-center text-[11px] font-semibold py-1.5 px-2.5 rounded-lg bg-emerald-950/80 border border-emerald-800 text-emerald-300 block";
            saveFeedback.textContent = "✓ Paleta salva com sucesso!";
            setTimeout(() => {
              saveFeedback.classList.add("hidden");
            }, 4000);
          }
        } else {
          updateSaveButtonState();
          if (saveFeedback) {
            saveFeedback.className = "text-center text-[11px] font-semibold py-1.5 px-2.5 rounded-lg bg-red-950/80 border border-red-800 text-red-300 block";
            saveFeedback.textContent = `Erro: ${result.error || "Falha ao salvar"}`;
          }
        }
      });

      // Device Switcher with Solid Colors
      btnDesktop?.addEventListener("click", () => {
        btnDesktop.className = "device-btn active px-3 py-1 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition cursor-pointer bg-[#2D2824] text-white border border-[#3D3630]";
        if (btnMobile) {
          btnMobile.className = "device-btn px-3 py-1 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition cursor-pointer text-[#9E968E] hover:text-white hover:bg-[#1B1815] border border-transparent";
        }

        if (wrapper && iframe) {
          wrapper.className = "w-full h-full transition-all duration-300 flex items-center justify-center";
          iframe.className = "w-full h-full bg-[#FAF8F5] rounded-xl shadow-2xl transition-all duration-300 border-2 border-[#2D2824]";
        }
      });

      btnMobile?.addEventListener("click", () => {
        btnMobile.className = "device-btn active px-3 py-1 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition cursor-pointer bg-[#2D2824] text-white border border-[#3D3630]";
        if (btnDesktop) {
          btnDesktop.className = "device-btn px-3 py-1 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition cursor-pointer text-[#9E968E] hover:text-white hover:bg-[#1B1815] border border-transparent";
        }

        if (wrapper && iframe) {
          wrapper.className = "w-full h-full transition-all duration-300 flex items-center justify-center p-4";
          iframe.className = "w-[390px] h-[844px] bg-[#FAF8F5] rounded-[48px] shadow-2xl transition-all duration-300 border-8 border-[#1B1815] ring-2 ring-[#2D2824]";
        }
      });

      btnReload?.addEventListener("click", () => {
        if (iframe) {
          iframe.src = `/?theme=${selectedTheme}`;
        }
      });
    </script>
  </body>
</html>
