      // --- ATOMIC MULTI-FILE SAVE HANDLER ---
      btnSaveAll?.addEventListener("click", async () => {
        const { isGeneralChanged, isTopbarChanged, isHeroChanged, totalChanged } = evaluateChanges();
        if (totalChanged === 0) return;

        const auth = getKeystaticAuth();
        const isDev = window.location.hostname === "localhost" || window.location.hostname === "127.0.0.1";

        if (!isDev && !auth.isAuthenticated) {
          if (saveFeedback) {
            saveFeedback.className = "text-center text-[11px] font-semibold py-2.5 px-3 rounded-xl bg-amber-950/90 border border-amber-700 text-amber-200 block";
            saveFeedback.innerHTML = `<span>Você precisa se conectar para salvar alterações.<br><button type="button" id="feedback-login-btn" class="mt-2 inline-flex items-center gap-1 px-3 py-1 rounded-lg bg-[#A8382B] hover:bg-[#82271D] text-white font-bold text-xs cursor-pointer shadow">Fazer Login no Studio ↗</button></span>`;
            document.getElementById("feedback-login-btn")?.addEventListener("click", () => {
              redirectToLogin();
            });
          }
          return;
        }

        btnSaveAll.disabled = true;
        btnSaveAll.className = "w-full py-2.5 px-4 rounded-xl bg-[#2D2824] text-white font-bold text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2 cursor-wait border border-transparent";
        if (saveBtnText) saveBtnText.textContent = "Salvando no site...";
        if (saveFeedback) saveFeedback.classList.add("hidden");

        const filesToSave: { path: string; contents: string }[] = [];
        const commitParts: string[] = [];

        if (isTopbarChanged) {
          filesToSave.push({
            path: "src/content/topbar.json",
            contents: JSON.stringify(currentTopbar, null, 2) + "\n",
          });
          commitParts.push("aviso do topo");
        }

        if (isHeroChanged) {
          filesToSave.push({
            path: "src/content/hero.json",
            contents: JSON.stringify(currentHero, null, 2) + "\n",
          });
          commitParts.push("hero");
        }

        if (isGeneralChanged) {
          filesToSave.push({
            path: "src/content/general.json",
            contents: JSON.stringify(currentGeneral, null, 2) + "\n",
          });
          commitParts.push("identidade e contato");
        }

        // Add changed or new collection items (excluding deleted)
        currentCollections.forEach((currData, path) => {
          if (deletedCollections.has(path)) return;
          const initData = initialCollections.get(path);
          if (!initData || JSON.stringify(currData) !== JSON.stringify(initData)) {
            filesToSave.push({
              path,
              contents: JSON.stringify(currData, null, 2) + "\n",
            });
            commitParts.push(path.split("/").pop()?.replace(".json", "") || "conteúdo");
          }
        });

        // Add deletions
        const deletionsToSave = Array.from(deletedCollections).map((p) => {
          commitParts.push(`remove ${p.split("/").pop()?.replace(".json", "") || "item"}`);
          return { path: p };
        });

        const commitMessage = `Atualiza ${commitParts.slice(0, 3).join(", ")}${commitParts.length > 3 ? "..." : ""} via Studio Admin`;

        const result = await saveContentFiles({
          message: commitMessage,
          files: filesToSave,
          deletions: deletionsToSave.length > 0 ? deletionsToSave : undefined,
        });

        if (result.success) {
          // Sync deleted collections
          deletedCollections.forEach((p) => {
            initialCollections.delete(p);
            currentCollections.delete(p);
          });
          deletedCollections.clear();

          // Sync initial state with current state
          Object.assign(initialGeneral, currentGeneral);
          Object.assign(initialTopbar, currentTopbar);
          Object.assign(initialHero, currentHero);

          currentCollections.forEach((currData, path) => {
            initialCollections.set(path, JSON.parse(JSON.stringify(currData)));
          });

          evaluateChanges();

          if (saveFeedback) {
            saveFeedback.className = "text-center text-[11px] font-semibold py-1.5 px-2.5 rounded-lg bg-emerald-950/80 border border-emerald-800 text-emerald-300 block";
            saveFeedback.textContent = "✓ Alterações publicadas com sucesso!";
            setTimeout(() => {
              saveFeedback.classList.add("hidden");
            }, 5000);
          }
        } else {
          evaluateChanges();
          if (saveFeedback) {
            saveFeedback.className = "text-center text-[11px] font-semibold py-2 px-3 rounded-lg bg-red-950/80 border border-red-800 text-red-300 block";
            if (result.error?.toLowerCase().includes("autentica") || result.error?.toLowerCase().includes("login")) {
              saveFeedback.innerHTML = `<span>Erro: ${result.error}<br><button type="button" id="err-login-btn" class="mt-1.5 underline text-amber-300 hover:text-white font-bold cursor-pointer">Fazer Login agora ↗</button></span>`;
              document.getElementById("err-login-btn")?.addEventListener("click", () => {
                redirectToLogin();
              });
            } else {
              saveFeedback.textContent = `Erro: ${result.error || "Falha ao salvar"}`;
            }
          }
        }
      });

      // --- DEVICE PRESETS HANDLER ---
      deviceBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const width = btn.getAttribute("data-width") || "100%";

          deviceBtns.forEach((b) => {
            b.classList.remove("active", "bg-[#2D2824]", "text-white", "border-[#3D3630]");
            b.classList.add("text-[#9E968E]", "border-transparent");
          });
          btn.classList.remove("text-[#9E968E]", "border-transparent");
          btn.classList.add("active", "bg-[#2D2824]", "text-white", "border-[#3D3630]");

          if (wrapper && iframe) {
            if (width === "100%") {
              wrapper.style.width = "100%";
              wrapper.style.height = "100%";
              iframe.className = "w-full h-full bg-[#FAF8F5] rounded-xl shadow-2xl transition-all duration-300 border-2 border-[#2D2824]";
              if (previewDimBadge) previewDimBadge.textContent = "100% Fluido";
            } else if (width === "390px") {
              wrapper.style.width = "390px";
              wrapper.style.height = "844px";
              iframe.className = "w-full h-full bg-[#FAF8F5] rounded-[44px] shadow-2xl transition-all duration-300 border-8 border-[#1B1815] ring-2 ring-[#2D2824]";
              if (previewDimBadge) previewDimBadge.textContent = "390px × 844px (iPhone)";
            } else {
              wrapper.style.width = width;
              wrapper.style.height = "92%";
              iframe.className = "w-full h-full bg-[#FAF8F5] rounded-2xl shadow-2xl transition-all duration-300 border-4 border-[#2D2824]";
              if (previewDimBadge) previewDimBadge.textContent = `${width} × ${Math.round(wrapper.offsetHeight)}px`;
            }
          }
        });
      });

      // --- DRAGGABLE IFRAME RESIZER (FREE DRAG WIDTH) ---
      let isIframeDragging = false;
      let iframeStartX = 0;
      let iframeStartWidth = 0;

      iframeResizer?.addEventListener("pointerdown", (e) => {
        isIframeDragging = true;
        iframeStartX = e.clientX;
        iframeStartWidth = wrapper?.offsetWidth || iframe.offsetWidth;

        if (iframe) iframe.style.pointerEvents = "none";
        document.body.style.cursor = "ew-resize";
        document.body.style.userSelect = "none";
        iframeResizer.setPointerCapture(e.pointerId);
      });

      iframeResizer?.addEventListener("pointermove", (e) => {
        if (!isIframeDragging || !wrapper) return;
        const deltaX = (e.clientX - iframeStartX) * 2;
        const newWidth = Math.max(320, Math.min(window.innerWidth - 100, iframeStartWidth + deltaX));

        wrapper.style.width = `${newWidth}px`;
        wrapper.style.maxWidth = "100%";

        if (previewDimBadge) {
          previewDimBadge.textContent = `${Math.round(newWidth)}px × ${Math.round(wrapper.offsetHeight)}px`;
        }

        // Unset device button active states when free-dragging
        deviceBtns.forEach((b) => {
          b.classList.remove("active", "bg-[#2D2824]", "text-white", "border-[#3D3630]");
          b.classList.add("text-[#9E968E]", "border-transparent");
        });
      });

      const stopIframeDrag = () => {
        if (!isIframeDragging) return;
        isIframeDragging = false;
        if (iframe) iframe.style.pointerEvents = "auto";
        document.body.style.cursor = "";
        document.body.style.userSelect = "";
      };

      iframeResizer?.addEventListener("pointerup", stopIframeDrag);
      iframeResizer?.addEventListener("pointercancel", stopIframeDrag);

      // --- DRAGGABLE SIDEBAR SPLITTER (DESKTOP) ---
      let isSidebarDragging = false;

      sidebarSplitter?.addEventListener("pointerdown", (e) => {
        isSidebarDragging = true;
        if (iframe) iframe.style.pointerEvents = "none";
        document.body.style.cursor = "col-resize";
        document.body.style.userSelect = "none";
        sidebarSplitter.setPointerCapture(e.pointerId);
      });

      sidebarSplitter?.addEventListener("pointermove", (e) => {
        if (!isSidebarDragging || !adminSidebar) return;
        const newWidth = Math.max(320, Math.min(650, e.clientX));
        adminSidebar.style.width = `${newWidth}px`;
      });

      const stopSidebarDrag = () => {
        if (!isSidebarDragging) return;
        isSidebarDragging = false;
        if (iframe) iframe.style.pointerEvents = "auto";
        document.body.style.cursor = "";
        document.body.style.userSelect = "";
      };

      sidebarSplitter?.addEventListener("pointerup", stopSidebarDrag);
      sidebarSplitter?.addEventListener("pointercancel", stopSidebarDrag);

      // --- RELOAD IFRAME ---
      btnReload?.addEventListener("click", () => {
        if (iframe) {
          iframe.src = `/?theme=${currentGeneral.theme || "terracotta"}`;
        }
      });

      // --- MOBILE / TABLET VIEW SWITCHER LOGIC (< 1024px) ---
      const mobileTabEditor = document.getElementById("mobile-tab-editor");
      const mobileTabPreview = document.getElementById("mobile-tab-preview");
      const mobileSwitchToPreviewBtn = document.getElementById("mobile-switch-to-preview-btn");
      const mobileBackToEditorBtn = document.getElementById("mobile-back-to-editor-btn");
      const previewMain = document.getElementById("preview-main");

      let currentMobileView: "editor" | "preview" = "editor";

      function setMobileView(view: "editor" | "preview") {
        currentMobileView = view;
        const isDesktop = window.innerWidth >= 1024;

        if (isDesktop) {
          // On desktop (lg+), always show both editor and preview side-by-side
          if (adminSidebar) {
            adminSidebar.classList.remove("hidden");
          }
          if (previewMain) {
            previewMain.classList.remove("hidden");
            previewMain.classList.add("flex");
          }
          if (mobileBackToEditorBtn) {
            mobileBackToEditorBtn.style.display = "none";
          }
          return;
        }

        // On mobile / tablet (< 1024px)
        if (adminSidebar) {
          adminSidebar.style.width = ""; // Reset inline width from desktop drag
        }

        if (view === "editor") {
          if (adminSidebar) adminSidebar.classList.remove("hidden");
          if (previewMain) {
            previewMain.classList.add("hidden");
            previewMain.classList.remove("flex");
          }
          if (mobileTabEditor) {
            mobileTabEditor.className = "mobile-view-btn active px-3 py-1.5 rounded-lg text-xs font-bold flex items-center gap-1.5 transition cursor-pointer bg-[#2D2824] text-white border border-[#3D3630]";
          }
          if (mobileTabPreview) {
            mobileTabPreview.className = "mobile-view-btn px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition cursor-pointer text-[#9E968E] hover:text-white border border-transparent";
          }
          if (mobileBackToEditorBtn) {
            mobileBackToEditorBtn.style.display = "none";
          }
        } else {
          // view === "preview"
          if (adminSidebar) adminSidebar.classList.add("hidden");
          if (previewMain) {
            previewMain.classList.remove("hidden");
            previewMain.classList.add("flex");
          }
          if (mobileTabPreview) {
            mobileTabPreview.className = "mobile-view-btn active px-3 py-1.5 rounded-lg text-xs font-bold flex items-center gap-1.5 transition cursor-pointer bg-[#2D2824] text-white border border-[#3D3630]";
          }
          if (mobileTabEditor) {
            mobileTabEditor.className = "mobile-view-btn px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition cursor-pointer text-[#9E968E] hover:text-white border border-transparent";
          }
          if (mobileBackToEditorBtn) {
            mobileBackToEditorBtn.style.display = "flex";
          }
        }
      }

      mobileTabEditor?.addEventListener("click", () => setMobileView("editor"));
      mobileTabPreview?.addEventListener("click", () => setMobileView("preview"));
      mobileSwitchToPreviewBtn?.addEventListener("click", () => setMobileView("preview"));
      mobileBackToEditorBtn?.addEventListener("click", () => setMobileView("editor"));

      window.addEventListener("resize", () => {
        setMobileView(currentMobileView);
      });

      // Initial layout setup for current viewport
      setMobileView("editor");
    </script>

    <!-- Global State Injection for Hydration -->
    <script define:vars={{
      generalData,
      topbarData,
      heroData,
      allCollections: [...servicesList, ...brandsList, ...casesList, ...testimonialsList]
    }}>
      window.__INITIAL_GENERAL__ = generalData;
      window.__INITIAL_TOPBAR__ = topbarData;
      window.__INITIAL_HERO__ = heroData;
      window.__COLLECTIONS__ = allCollections;
    </script>
  </body>
</html>
