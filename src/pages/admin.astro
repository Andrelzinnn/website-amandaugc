        id="sidebar-splitter"
        class="hidden lg:flex w-2 bg-[#12100E] hover:bg-[#A8382B] active:bg-[#A8382B] cursor-col-resize items-center justify-center border-r border-[#2D2824] transition-colors z-20 group select-none flex-shrink-0"
        title="Arraste para redimensionar a largura do painel"
      >
        <div class="w-0.5 h-8 bg-[#3D3630] group-hover:bg-white rounded-full transition-colors"></div>
      </div>

      <!-- Right Main: Live Preview Frame with Resizable Width Handle -->
      <main class="flex-1 bg-[#0D0B0A] relative flex flex-col items-center justify-center overflow-hidden p-2 sm:p-5 select-none min-w-0">
        <!-- Floating Dimension & Scale Badge -->
        <div class="absolute top-3 left-1/2 -translate-x-1/2 z-20 flex items-center gap-2 bg-[#1B1815]/90 border border-[#2D2824] px-3 py-1 rounded-full text-[11px] text-[#C4BDB5] shadow-lg backdrop-blur pointer-events-none select-none">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          <span id="preview-dim-badge">100% Fluido</span>
        </div>

        <!-- Preview Wrapper Container with Drag Handle -->
        <div id="preview-wrapper" class="relative max-w-full max-h-full flex items-center justify-center transition-all duration-150" style="width: 100%; height: 100%;">
          <iframe
            id="preview-frame"
            src={`/?theme=${currentTheme}`}
            class="w-full h-full bg-[#FAF8F5] rounded-xl shadow-2xl transition-all duration-300 border-2 border-[#2D2824]"
            title="Visualização ao Vivo do Portfólio"
          ></iframe>

          <!-- Right Draggable Resize Handle -->
          <div
            id="iframe-resizer-right"
            class="absolute -right-3.5 top-1/2 -translate-y-1/2 w-4 h-24 bg-[#24201C] hover:bg-[#A8382B] active:bg-[#A8382B] rounded-full border border-[#3D3630] flex items-center justify-center cursor-ew-resize transition-colors shadow-2xl z-30 group select-none"
            title="Arraste para redimensionar a largura da tela"
          >
            <div class="flex flex-col gap-1 items-center pointer-events-none">
              <span class="w-1 h-1 rounded-full bg-[#9E968E] group-hover:bg-white"></span>
              <span class="w-1 h-1 rounded-full bg-[#9E968E] group-hover:bg-white"></span>
              <span class="w-1 h-1 rounded-full bg-[#9E968E] group-hover:bg-white"></span>
            </div>
          </div>
        </div>
      </main>
    </div>

    <!-- Client-Side Script with Solid State Management -->
    <script>
      import { saveContentFiles, getKeystaticAuth, redirectToLogin } from "../lib/keystaticClient";

      // Elements
      const iframe = document.getElementById("preview-frame") as HTMLIFrameElement;
      const wrapper = document.getElementById("preview-wrapper");
      const previewDimBadge = document.getElementById("preview-dim-badge");
      const iframeResizer = document.getElementById("iframe-resizer-right");
      const sidebarSplitter = document.getElementById("sidebar-splitter");
      const adminSidebar = document.getElementById("admin-sidebar");
      const btnReload = document.getElementById("btn-reload");
      const deviceBtns = document.querySelectorAll(".device-btn");
      const moduleTabs = document.querySelectorAll(".module-tab");
      const tabPanels = document.querySelectorAll(".tab-panel");
      const paletteCards = document.querySelectorAll(".palette-card");
      const btnSaveAll = document.getElementById("btn-save-all") as HTMLButtonElement;
      const saveBtnText = document.getElementById("save-btn-text");
      const pendingBadge = document.getElementById("pending-badge");
      const pendingCount = document.getElementById("pending-count");
      const saveFeedback = document.getElementById("save-feedback");
      const authStatusDot = document.getElementById("auth-status-dot");
      const authStatusText = document.getElementById("auth-status-text");
      const btnAuthAction = document.getElementById("btn-auth-action");

      // Tabs scroll buttons
      const tabsScrollContainer = document.getElementById("tabs-scroll-container");
      const btnScrollLeft = document.getElementById("tabs-scroll-left");
      const btnScrollRight = document.getElementById("tabs-scroll-right");

      // Inject server-rendered data into client memory
      const initialGeneral = { ...window.__INITIAL_GENERAL__ };
      const currentGeneral = { ...initialGeneral };

      const initialTopbar = { ...window.__INITIAL_TOPBAR__ };
      const currentTopbar = { ...initialTopbar };

      const initialHero = { ...window.__INITIAL_HERO__ };
      const currentHero = { ...initialHero };

      // Collections State Map: path -> data
      const initialCollections = new Map<string, any>();
      const currentCollections = new Map<string, any>();

      if (window.__COLLECTIONS__) {
        window.__COLLECTIONS__.forEach((item: { path: string; data: any }) => {
          initialCollections.set(item.path, JSON.parse(JSON.stringify(item.data)));
          currentCollections.set(item.path, JSON.parse(JSON.stringify(item.data)));
        });
      }

      // Live update helper in iframe
      function updateIframeText(selector: string, text: string) {
        if (!iframe || !iframe.contentWindow) return;
        try {
          const doc = iframe.contentWindow.document;
          const els = doc.querySelectorAll(selector);
          els.forEach((el) => {
            el.textContent = text;
          });
        } catch (e) {}
      }

      // Auth UI Setup
      function updateAuthUI() {
        const auth = getKeystaticAuth();
        const isDev = window.location.hostname === "localhost" || window.location.hostname === "127.0.0.1";

        const headerLoginBtn = document.getElementById("header-login-btn");
        const headerAuthBadge = document.getElementById("header-auth-badge");
        const authWarningBanner = document.getElementById("auth-warning-banner");
        const bannerLoginBtn = document.getElementById("banner-login-btn");

        if (isDev) {
          if (authStatusDot) authStatusDot.className = "w-2 h-2 rounded-full bg-emerald-500";
          if (authStatusText) authStatusText.textContent = "Modo Local (Dev)";
          if (btnAuthAction) btnAuthAction.classList.add("hidden");
          if (headerLoginBtn) headerLoginBtn.classList.add("hidden");
          if (headerAuthBadge) {
            headerAuthBadge.classList.remove("hidden");
            headerAuthBadge.classList.add("inline-flex");
            headerAuthBadge.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-500"></span><span>Modo Local</span>';
          }
          if (authWarningBanner) authWarningBanner.classList.add("hidden");
        } else if (auth.isAuthenticated) {
          if (authStatusDot) authStatusDot.className = "w-2 h-2 rounded-full bg-emerald-500";
          if (authStatusText) authStatusText.textContent = "Conectado ao Keystatic Cloud";
          if (btnAuthAction) btnAuthAction.classList.add("hidden");
          if (headerLoginBtn) headerLoginBtn.classList.add("hidden");
          if (headerAuthBadge) {
            headerAuthBadge.classList.remove("hidden");
            headerAuthBadge.classList.add("inline-flex");
            headerAuthBadge.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-500"></span><span>Conectado</span>';
          }
          if (authWarningBanner) authWarningBanner.classList.add("hidden");
        } else {
          if (authStatusDot) authStatusDot.className = "w-2 h-2 rounded-full bg-amber-500 animate-pulse";
          if (authStatusText) authStatusText.textContent = "Desconectado";
          if (btnAuthAction) {
            btnAuthAction.classList.remove("hidden");
            btnAuthAction.onclick = () => redirectToLogin();
          }
          if (headerLoginBtn) {
            headerLoginBtn.classList.remove("hidden");
            headerLoginBtn.onclick = () => redirectToLogin();
          }
          if (headerAuthBadge) {
            headerAuthBadge.classList.add("hidden");
            headerAuthBadge.classList.remove("inline-flex");
          }
          if (authWarningBanner) {
            authWarningBanner.classList.remove("hidden");
            if (bannerLoginBtn) {
              bannerLoginBtn.onclick = () => redirectToLogin();
            }
          }
        }
      }

      updateAuthUI();

      // Horizontal Tabs Scroll buttons & Wheel scroll
      btnScrollLeft?.addEventListener("click", () => {
        tabsScrollContainer?.scrollBy({ left: -140, behavior: "smooth" });
      });

      btnScrollRight?.addEventListener("click", () => {
        tabsScrollContainer?.scrollBy({ left: 140, behavior: "smooth" });
      });

      tabsScrollContainer?.addEventListener("wheel", (e) => {
        if (e.deltaY !== 0) {
          e.preventDefault();
          tabsScrollContainer.scrollLeft += e.deltaY;
        }
      }, { passive: false });

      // --- UNIFIED TAB ACTIVATION & BIDIRECTIONAL SCROLL-SPY ---
      let isProgrammaticScroll = false;
      let scrollTimeout: any = null;
      let lastSpiedSection = "";

      const sectionToTabMap: Record<string, string> = {
        hero: "hero",
        marcas: "brands",
        cases: "cases",
        servicos: "services",
        depoimentos: "testimonials",
        contato: "contact",
      };

      function activateTab(targetTab: string, scrollIframe: boolean = true) {
        const targetBtn = document.querySelector(`.module-tab[data-tab="${targetTab}"]`);
        if (!targetBtn) return;

        moduleTabs.forEach((t) => {
          t.classList.remove("active", "bg-[#24201C]", "text-white", "border-[#3D3630]");
          t.classList.add("text-[#9E968E]", "border-transparent");
        });

        targetBtn.classList.remove("text-[#9E968E]", "border-transparent");
        targetBtn.classList.add("active", "bg-[#24201C]", "text-white", "border-[#3D3630]");

        // Ensure the active tab button is scrolled into view in the horizontal tabs bar
        if (tabsScrollContainer) {
          const btnEl = targetBtn as HTMLElement;
          const containerLeft = tabsScrollContainer.scrollLeft;
          const containerWidth = tabsScrollContainer.clientWidth;
          const btnLeft = btnEl.offsetLeft;
          const btnWidth = btnEl.offsetWidth;

          if (btnLeft < containerLeft || btnLeft + btnWidth > containerLeft + containerWidth) {
            tabsScrollContainer.scrollTo({
              left: Math.max(0, btnLeft - 20),
              behavior: "smooth",
            });
          }
        }

        tabPanels.forEach((panel) => {
          panel.classList.add("hidden");
        });

        const activePanel = document.getElementById(`panel-${targetTab}`);
        if (activePanel) {
          activePanel.classList.remove("hidden");
        }

        if (scrollIframe) {
          const targetAnchor = targetBtn.getAttribute("data-target-anchor");
          if (targetAnchor && iframe && iframe.contentWindow) {
            try {
              const doc = iframe.contentWindow.document;
              const el = doc.getElementById(targetAnchor);
              if (el) {
                isProgrammaticScroll = true;
                clearTimeout(scrollTimeout);
                scrollTimeout = setTimeout(() => {
                  isProgrammaticScroll = false;
                }, 900);

                const elTop = el.getBoundingClientRect().top + iframe.contentWindow.scrollY;
                iframe.contentWindow.scrollTo({
                  top: Math.max(0, elTop - 24),
                  behavior: "smooth",
                });
              }
            } catch (e) {}
          }
        }
      }

      // User tab click
      moduleTabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const targetTab = tab.getAttribute("data-tab");
          if (targetTab) activateTab(targetTab, true);
        });
      });

      // Scroll Spy: Listening to Iframe Scroll to update active Editor Tab
      function setupIframeScrollSpy() {
        if (!iframe || !iframe.contentWindow) return;
        try {
          const iframeWin = iframe.contentWindow;
          const iframeDoc = iframe.contentDocument;
          if (!iframeDoc) return;

          const sectionIds = ["hero", "marcas", "cases", "servicos", "depoimentos", "contato"];

          const handleIframeScroll = () => {
            if (isProgrammaticScroll) return;

            const scrollY = iframeWin.scrollY;
            if (scrollY < 60) {
              if (lastSpiedSection !== "hero") {
                lastSpiedSection = "hero";
                activateTab("hero", false);
              }
              return;
            }

            const viewportAnchor = scrollY + (iframeWin.innerHeight * 0.35);
            let matchedSection = "";

            for (const sId of sectionIds) {
              const el = iframeDoc.getElementById(sId);
              if (!el) continue;
              const top = el.offsetTop;
              const bottom = top + el.offsetHeight;

              if (viewportAnchor >= top && viewportAnchor < bottom) {
                matchedSection = sId;
                break;
              }
            }

            if (matchedSection && matchedSection !== lastSpiedSection) {
              lastSpiedSection = matchedSection;
              const mappedTab = sectionToTabMap[matchedSection];
              if (mappedTab) {
                activateTab(mappedTab, false);
              }
            }
          };

          iframeWin.removeEventListener("scroll", handleIframeScroll);
          iframeWin.addEventListener("scroll", handleIframeScroll, { passive: true });
        } catch (e) {}
      }

      iframe.addEventListener("load", setupIframeScrollSpy);

      // Quick Scroll to Card Buttons inside panels (strictly scroll panels-container, never parent page)
      const panelsContainer = document.getElementById("panels-container");
      document.querySelectorAll(".scroll-to-card-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const targetId = btn.getAttribute("data-target");
          if (!targetId) return;
          const targetCard = document.getElementById(targetId);
          if (targetCard && panelsContainer) {
            const cardTop = targetCard.offsetTop;
            panelsContainer.scrollTo({
              top: Math.max(0, cardTop - 12),
              behavior: "smooth",
            });
            targetCard.classList.add("border-[#A8382B]", "ring-2", "ring-[#A8382B]/40");
            setTimeout(() => {
              targetCard.classList.remove("border-[#A8382B]", "ring-2", "ring-[#A8382B]/40");
            }, 1500);
          }
        });
      });

      // Dirty Tracking & Save Button State
      function evaluateChanges() {
        let changedCount = 0;

        const isGeneralChanged = JSON.stringify(currentGeneral) !== JSON.stringify(initialGeneral);
        const isTopbarChanged = JSON.stringify(currentTopbar) !== JSON.stringify(initialTopbar);
        const isHeroChanged = JSON.stringify(currentHero) !== JSON.stringify(initialHero);

        if (isGeneralChanged) changedCount++;
        if (isTopbarChanged) changedCount++;
        if (isHeroChanged) changedCount++;

        // Check collections
        let collectionsChanged = 0;
        currentCollections.forEach((currData, path) => {
          const initData = initialCollections.get(path);
          if (JSON.stringify(currData) !== JSON.stringify(initData)) {
            collectionsChanged++;
          }
        });

        const totalChanged = changedCount + collectionsChanged;

        if (totalChanged > 0) {
          if (pendingBadge) {
            pendingBadge.classList.remove("hidden");
            pendingBadge.classList.add("flex");
          }
          if (pendingCount) {
            pendingCount.textContent = `${totalChanged} item${totalChanged > 1 ? "ns" : ""} modificado${totalChanged > 1 ? "s" : ""}`;
          }

          if (btnSaveAll && saveBtnText) {
            btnSaveAll.disabled = false;
            btnSaveAll.className = "w-full py-2.5 px-4 rounded-xl bg-[#A8382B] hover:bg-[#82271D] text-white font-bold text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2 cursor-pointer shadow-lg shadow-[#A8382B]/20 border border-[#C28D3F]/40";
            saveBtnText.textContent = "Salvar e Publicar no Site";
          }
        } else {
          if (pendingBadge) {
            pendingBadge.classList.add("hidden");
            pendingBadge.classList.remove("flex");
          }

          if (btnSaveAll && saveBtnText) {
            btnSaveAll.disabled = true;
            btnSaveAll.className = "w-full py-2.5 px-4 rounded-xl bg-[#2D2824] text-[#8A827B] font-bold text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2 cursor-not-allowed border border-transparent select-none";
            saveBtnText.textContent = "Nenhuma Alteração";
          }
        }

        return { isGeneralChanged, isTopbarChanged, isHeroChanged, totalChanged };
      }

      // --- MODULE 1: PALETTE SWATCHES ---
      paletteCards.forEach((card) => {
        card.addEventListener("click", () => {
          const theme = card.getAttribute("data-theme") || "terracotta";
          currentGeneral.theme = theme;

          paletteCards.forEach((c) => {
            c.classList.remove("border-[#A8382B]", "bg-[#361A16]", "active-card");
            c.classList.add("border-[#2D2824]", "bg-[#24201C]");
            const check = c.querySelector(".check-icon");
            if (check) check.classList.add("hidden");
          });

          card.classList.remove("border-[#2D2824]", "bg-[#24201C]");
          card.classList.add("border-[#A8382B]", "bg-[#361A16]", "active-card");
          const check = card.querySelector(".check-icon");
          if (check) check.classList.remove("hidden");

          evaluateChanges();

          // Live update in iframe
          if (iframe && iframe.contentWindow) {
            try {
              iframe.contentWindow.document.documentElement.setAttribute("data-theme", theme);
            } catch (e) {
              iframe.src = `/?theme=${theme}`;
            }
          }
        });
      });

      // --- MODULE 2: TOPBAR LIVE-BINDING & PRESETS ---
      const inputTopbarBadge = document.getElementById("input-topbar-badge") as HTMLInputElement;
      const inputTopbarText = document.getElementById("input-topbar-text") as HTMLTextAreaElement;
      const inputTopbarCta = document.getElementById("input-topbar-cta") as HTMLInputElement;

      inputTopbarBadge?.addEventListener("input", (e) => {
        const val = (e.target as HTMLInputElement).value;
        currentTopbar.badge = val;
        updateIframeText('[data-i18n="topbar.badge"]', val);
        evaluateChanges();
      });

      inputTopbarText?.addEventListener("input", (e) => {
        const val = (e.target as HTMLTextAreaElement).value;
        currentTopbar.text = val;
        updateIframeText('[data-i18n="topbar.text"]', val);
        evaluateChanges();
      });

      inputTopbarCta?.addEventListener("input", (e) => {
        const val = (e.target as HTMLInputElement).value;
        currentTopbar.ctaText = val;
        updateIframeText('[data-i18n="topbar.cta"]', val);
        evaluateChanges();
      });

      // Topbar presets buttons
      document.querySelectorAll(".topbar-preset-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const badge = btn.getAttribute("data-badge") || "";
          const text = btn.getAttribute("data-text") || "";
          const cta = btn.getAttribute("data-cta") || "";

          if (inputTopbarBadge) inputTopbarBadge.value = badge;
          if (inputTopbarText) inputTopbarText.value = text;
          if (inputTopbarCta) inputTopbarCta.value = cta;

          currentTopbar.badge = badge;
          currentTopbar.text = text;
          currentTopbar.ctaText = cta;

          updateIframeText('[data-i18n="topbar.badge"]', badge);
          updateIframeText('[data-i18n="topbar.text"]', text);
          updateIframeText('[data-i18n="topbar.cta"]', cta);

          evaluateChanges();
        });
      });

      // --- MODULE 3: HERO LIVE-BINDING ---
      const inputHeroHeadline = document.getElementById("input-hero-headline") as HTMLInputElement;
      const inputHeroCursive = document.getElementById("input-hero-cursive") as HTMLInputElement;
      const inputHeroSubheadline = document.getElementById("input-hero-subheadline") as HTMLTextAreaElement;
      const inputHeroM1Val = document.getElementById("input-hero-m1-val") as HTMLInputElement;
      const inputHeroM1Lbl = document.getElementById("input-hero-m1-lbl") as HTMLInputElement;
      const inputHeroM2Val = document.getElementById("input-hero-m2-val") as HTMLInputElement;
      const inputHeroM2Lbl = document.getElementById("input-hero-m2-lbl") as HTMLInputElement;
      const inputHeroM3Val = document.getElementById("input-hero-m3-val") as HTMLInputElement;
      const inputHeroM3Lbl = document.getElementById("input-hero-m3-lbl") as HTMLInputElement;

      inputHeroHeadline?.addEventListener("input", (e) => {
        const val = (e.target as HTMLInputElement).value;
        currentHero.headline = val;
        updateIframeText('[data-i18n="hero.headline"]', val);
        evaluateChanges();
      });

      inputHeroCursive?.addEventListener("input", (e) => {
        const val = (e.target as HTMLInputElement).value;
        currentHero.headlineCursive = val;
        updateIframeText('[data-i18n="hero.headlineCursive"]', val);
        evaluateChanges();
      });

      inputHeroSubheadline?.addEventListener("input", (e) => {
        const val = (e.target as HTMLTextAreaElement).value;
        currentHero.subheadline = val;
        updateIframeText('[data-i18n="hero.subheadline"]', val);
        evaluateChanges();
      });

      const inputHeroPhoto = document.getElementById("input-hero-photo") as HTMLInputElement;
      inputHeroPhoto?.addEventListener("input", (e) => {
        const val = (e.target as HTMLInputElement).value;
        currentHero.photoUrl = val;

        // Live preview da foto no iframe (convertendo link do Google Drive se houver)
        if (iframe && iframe.contentWindow) {
          try {
            const img = iframe.contentWindow.document.querySelector("#hero img") as HTMLImageElement;
            if (img) {
              const driveMatch = val.match(/\/file\/d\/([a-zA-Z0-9_-]+)/) || val.match(/[?&]id=([a-zA-Z0-9_-]+)/);
              img.src = driveMatch ? `https://lh3.googleusercontent.com/d/${driveMatch[1]}` : val;
            }
          } catch (e) {}
        }
        evaluateChanges();
      });

      inputHeroM1Val?.addEventListener("input", (e) => {
        const val = (e.target as HTMLInputElement).value;
        currentHero.metric1Value = val;
        updateIframeText('[data-i18n="hero.metric1.value"]', val);
        evaluateChanges();
      });

      inputHeroM1Lbl?.addEventListener("input", (e) => {
        const val = (e.target as HTMLInputElement).value;
        currentHero.metric1Label = val;
        updateIframeText('[data-i18n="hero.metric1.label"]', val);
        evaluateChanges();
      });

      inputHeroM2Val?.addEventListener("input", (e) => {
        const val = (e.target as HTMLInputElement).value;
        currentHero.metric2Value = val;
        updateIframeText('[data-i18n="hero.metric2.value"]', val);
        evaluateChanges();
      });

      inputHeroM2Lbl?.addEventListener("input", (e) => {
        const val = (e.target as HTMLInputElement).value;
        currentHero.metric2Label = val;
        updateIframeText('[data-i18n="hero.metric2.label"]', val);
        evaluateChanges();
      });

      inputHeroM3Val?.addEventListener("input", (e) => {
        const val = (e.target as HTMLInputElement).value;
        currentHero.metric3Value = val;
        updateIframeText('[data-i18n="hero.metric3.value"]', val);
        evaluateChanges();
      });

      inputHeroM3Lbl?.addEventListener("input", (e) => {
        const val = (e.target as HTMLInputElement).value;
        currentHero.metric3Label = val;
        updateIframeText('[data-i18n="hero.metric3.label"]', val);
        evaluateChanges();
      });

      // --- MODULE 4: SERVICES INPUTS ---
      document.querySelectorAll(".service-input").forEach((input) => {
        input.addEventListener("input", (e) => {
          const el = e.target as HTMLInputElement | HTMLTextAreaElement;
          const path = el.getAttribute("data-path");
          const field = el.getAttribute("data-field");
          if (!path || !field) return;

          const data = currentCollections.get(path);
          if (data) {
            data[field] = el.value;
            evaluateChanges();
          }
        });
      });

      // --- MODULE 5: BRANDS INPUTS ---
      document.querySelectorAll(".brand-input").forEach((input) => {
        input.addEventListener("input", (e) => {
          const el = e.target as HTMLInputElement;
          const path = el.getAttribute("data-path");
          const field = el.getAttribute("data-field");
          if (!path || !field) return;

          const data = currentCollections.get(path);
          if (data) {
            data[field] = el.value;
            evaluateChanges();
          }
        });
      });

      // --- MODULE 6: CASES INPUTS ---
      document.querySelectorAll(".case-input").forEach((input) => {
        input.addEventListener("input", (e) => {
          const el = e.target as HTMLInputElement | HTMLTextAreaElement;
          const path = el.getAttribute("data-path");
          const field = el.getAttribute("data-field");
          if (!path || !field) return;

          const data = currentCollections.get(path);
          if (data) {
            data[field] = el.value;
            evaluateChanges();
          }
        });
      });

      // --- MODULE 7: TESTIMONIALS INPUTS ---
      document.querySelectorAll(".test-input").forEach((input) => {
        input.addEventListener("input", (e) => {
          const el = e.target as HTMLInputElement | HTMLTextAreaElement;
          const path = el.getAttribute("data-path");
          const field = el.getAttribute("data-field");
          if (!path || !field) return;

          const data = currentCollections.get(path);
          if (data) {
            data[field] = el.value;
            evaluateChanges();
          }
        });
      });

      // --- MODULE 8: CONTACT LIVE-BINDING ---
      const inputContactFullName = document.getElementById("input-contact-fullname") as HTMLInputElement;
      const inputContactRole = document.getElementById("input-contact-role") as HTMLInputElement;
      const inputContactInstagram = document.getElementById("input-contact-instagram") as HTMLInputElement;
      const inputContactTiktok = document.getElementById("input-contact-tiktok") as HTMLInputElement;
      const inputContactWhatsapp = document.getElementById("input-contact-whatsapp") as HTMLInputElement;

      inputContactFullName?.addEventListener("input", (e) => {
        currentGeneral.fullName = (e.target as HTMLInputElement).value;
        evaluateChanges();
      });

      inputContactRole?.addEventListener("input", (e) => {
        currentGeneral.role = (e.target as HTMLInputElement).value;
        evaluateChanges();
      });

      inputContactInstagram?.addEventListener("input", (e) => {
        currentGeneral.instagram = (e.target as HTMLInputElement).value;
        evaluateChanges();
      });

      inputContactTiktok?.addEventListener("input", (e) => {
        currentGeneral.tiktok = (e.target as HTMLInputElement).value;
        evaluateChanges();
      });

      inputContactWhatsapp?.addEventListener("input", (e) => {
        currentGeneral.whatsappNumber = (e.target as HTMLInputElement).value;
        evaluateChanges();
      });

      // --- ATOMIC MULTI-FILE SAVE HANDLER ---
      btnSaveAll?.addEventListener("click", async () => {
        const { isGeneralChanged, isTopbarChanged, isHeroChanged, totalChanged } = evaluateChanges();
        if (totalChanged === 0) return;

        const auth = getKeystaticAuth();
        const isDev = window.location.hostname === "localhost" || window.location.hostname === "127.0.0.1";

        if (!isDev && !auth.isAuthenticated) {
          if (saveFeedback) {
            saveFeedback.className = "text-center text-[11px] font-semibold py-2.5 px-3 rounded-xl bg-amber-950/90 border border-amber-700 text-amber-200 block";
            saveFeedback.innerHTML = `<span>Você precisa se conectar para salvar alterações.<br><button type="button" id="feedback-login-btn" class="mt-2 inline-flex items-center gap-1 px-3 py-1 rounded-lg bg-[#A8382B] hover:bg-[#82271D] text-white font-bold text-xs cursor-pointer shadow">Fazer Login no Keystatic ↗</button></span>`;
            document.getElementById("feedback-login-btn")?.addEventListener("click", () => {
              redirectToLogin();
            });
          }
          return;
        }

        btnSaveAll.disabled = true;
        btnSaveAll.className = "w-full py-2.5 px-4 rounded-xl bg-[#2D2824] text-white font-bold text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2 cursor-wait border border-transparent";
        if (saveBtnText) saveBtnText.textContent = "Publicando no GitHub...";
        if (saveFeedback) saveFeedback.classList.add("hidden");

        const filesToSave: { path: string; contents: string }[] = [];
        const commitParts: string[] = [];

        if (isTopbarChanged) {
          filesToSave.push({
            path: "src/content/topbar.json",
            contents: JSON.stringify(currentTopbar, null, 2) + "\n",
          });
          commitParts.push("aviso do topo");
        }

        if (isHeroChanged) {
          filesToSave.push({
            path: "src/content/hero.json",
            contents: JSON.stringify(currentHero, null, 2) + "\n",
          });
          commitParts.push("hero");
        }

        if (isGeneralChanged) {
          filesToSave.push({
            path: "src/content/general.json",
            contents: JSON.stringify(currentGeneral, null, 2) + "\n",
          });
          commitParts.push("identidade e contato");
        }

        // Add changed collection items
        currentCollections.forEach((currData, path) => {
          const initData = initialCollections.get(path);
          if (JSON.stringify(currData) !== JSON.stringify(initData)) {
            filesToSave.push({
              path,
              contents: JSON.stringify(currData, null, 2) + "\n",
            });
            commitParts.push(path.split("/").pop()?.replace(".json", "") || "conteúdo");
          }
        });

        const commitMessage = `Atualiza ${commitParts.slice(0, 3).join(", ")}${commitParts.length > 3 ? "..." : ""} via Studio Admin`;

        const result = await saveContentFiles({
          message: commitMessage,
          files: filesToSave,
        });

        if (result.success) {
          // Sync initial state with current state
          Object.assign(initialGeneral, currentGeneral);
          Object.assign(initialTopbar, currentTopbar);
          Object.assign(initialHero, currentHero);

          currentCollections.forEach((currData, path) => {
            initialCollections.set(path, JSON.parse(JSON.stringify(currData)));
          });

          evaluateChanges();

          if (saveFeedback) {
            saveFeedback.className = "text-center text-[11px] font-semibold py-1.5 px-2.5 rounded-lg bg-emerald-950/80 border border-emerald-800 text-emerald-300 block";
            saveFeedback.textContent = "✓ Alterações publicadas com sucesso!";
            setTimeout(() => {
              saveFeedback.classList.add("hidden");
            }, 5000);
          }
        } else {
          evaluateChanges();
          if (saveFeedback) {
            saveFeedback.className = "text-center text-[11px] font-semibold py-2 px-3 rounded-lg bg-red-950/80 border border-red-800 text-red-300 block";
            if (result.error?.toLowerCase().includes("autentica") || result.error?.toLowerCase().includes("login")) {
              saveFeedback.innerHTML = `<span>Erro: ${result.error}<br><button type="button" id="err-login-btn" class="mt-1.5 underline text-amber-300 hover:text-white font-bold cursor-pointer">Fazer Login agora ↗</button></span>`;
              document.getElementById("err-login-btn")?.addEventListener("click", () => {
                redirectToLogin();
              });
            } else {
              saveFeedback.textContent = `Erro: ${result.error || "Falha ao salvar"}`;
            }
          }
        }
      });

      // --- DEVICE PRESETS HANDLER ---
      deviceBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const width = btn.getAttribute("data-width") || "100%";

          deviceBtns.forEach((b) => {
            b.classList.remove("active", "bg-[#2D2824]", "text-white", "border-[#3D3630]");
            b.classList.add("text-[#9E968E]", "border-transparent");
          });
          btn.classList.remove("text-[#9E968E]", "border-transparent");
          btn.classList.add("active", "bg-[#2D2824]", "text-white", "border-[#3D3630]");

          if (wrapper && iframe) {
            if (width === "100%") {
              wrapper.style.width = "100%";
              wrapper.style.height = "100%";
              iframe.className = "w-full h-full bg-[#FAF8F5] rounded-xl shadow-2xl transition-all duration-300 border-2 border-[#2D2824]";
              if (previewDimBadge) previewDimBadge.textContent = "100% Fluido";
            } else if (width === "390px") {
              wrapper.style.width = "390px";
              wrapper.style.height = "844px";
              iframe.className = "w-full h-full bg-[#FAF8F5] rounded-[44px] shadow-2xl transition-all duration-300 border-8 border-[#1B1815] ring-2 ring-[#2D2824]";
              if (previewDimBadge) previewDimBadge.textContent = "390px × 844px (iPhone)";
            } else {
              wrapper.style.width = width;
              wrapper.style.height = "92%";
              iframe.className = "w-full h-full bg-[#FAF8F5] rounded-2xl shadow-2xl transition-all duration-300 border-4 border-[#2D2824]";
              if (previewDimBadge) previewDimBadge.textContent = `${width} × ${Math.round(wrapper.offsetHeight)}px`;
            }
          }
        });
      });

      // --- DRAGGABLE IFRAME RESIZER (FREE DRAG WIDTH) ---
      let isIframeDragging = false;
      let iframeStartX = 0;
      let iframeStartWidth = 0;

      iframeResizer?.addEventListener("pointerdown", (e) => {
        isIframeDragging = true;
        iframeStartX = e.clientX;
        iframeStartWidth = wrapper?.offsetWidth || iframe.offsetWidth;

        if (iframe) iframe.style.pointerEvents = "none";
        document.body.style.cursor = "ew-resize";
        document.body.style.userSelect = "none";
        iframeResizer.setPointerCapture(e.pointerId);
      });

      iframeResizer?.addEventListener("pointermove", (e) => {
        if (!isIframeDragging || !wrapper) return;
        const deltaX = (e.clientX - iframeStartX) * 2;
        const newWidth = Math.max(320, Math.min(window.innerWidth - 100, iframeStartWidth + deltaX));

        wrapper.style.width = `${newWidth}px`;
        wrapper.style.maxWidth = "100%";

        if (previewDimBadge) {
          previewDimBadge.textContent = `${Math.round(newWidth)}px × ${Math.round(wrapper.offsetHeight)}px`;
        }

        // Unset device button active states when free-dragging
        deviceBtns.forEach((b) => {
          b.classList.remove("active", "bg-[#2D2824]", "text-white", "border-[#3D3630]");
          b.classList.add("text-[#9E968E]", "border-transparent");
        });
      });

      const stopIframeDrag = () => {
        if (!isIframeDragging) return;
        isIframeDragging = false;
        if (iframe) iframe.style.pointerEvents = "auto";
        document.body.style.cursor = "";
        document.body.style.userSelect = "";
      };

      iframeResizer?.addEventListener("pointerup", stopIframeDrag);
      iframeResizer?.addEventListener("pointercancel", stopIframeDrag);

      // --- DRAGGABLE SIDEBAR SPLITTER (DESKTOP) ---
      let isSidebarDragging = false;

      sidebarSplitter?.addEventListener("pointerdown", (e) => {
        isSidebarDragging = true;
        if (iframe) iframe.style.pointerEvents = "none";
        document.body.style.cursor = "col-resize";
        document.body.style.userSelect = "none";
        sidebarSplitter.setPointerCapture(e.pointerId);
      });

      sidebarSplitter?.addEventListener("pointermove", (e) => {
        if (!isSidebarDragging || !adminSidebar) return;
        const newWidth = Math.max(320, Math.min(650, e.clientX));
        adminSidebar.style.width = `${newWidth}px`;
      });

      const stopSidebarDrag = () => {
        if (!isSidebarDragging) return;
        isSidebarDragging = false;
        if (iframe) iframe.style.pointerEvents = "auto";
        document.body.style.cursor = "";
        document.body.style.userSelect = "";
      };

      sidebarSplitter?.addEventListener("pointerup", stopSidebarDrag);
      sidebarSplitter?.addEventListener("pointercancel", stopSidebarDrag);

      // --- RELOAD IFRAME ---
      btnReload?.addEventListener("click", () => {
        if (iframe) {
          iframe.src = `/?theme=${currentGeneral.theme || "terracotta"}`;
        }
      });
    </script>

    <!-- Global State Injection for Hydration -->
    <script define:vars={{
      generalData,
      topbarData,
      heroData,
      allCollections: [...servicesList, ...brandsList, ...casesList, ...testimonialsList]
    }}>
      window.__INITIAL_GENERAL__ = generalData;
      window.__INITIAL_TOPBAR__ = topbarData;
      window.__INITIAL_HERO__ = heroData;
      window.__COLLECTIONS__ = allCollections;
    </script>
  </body>
</html>
