                  <div>
                    <label class="block text-[10px] font-bold text-[#8A827B] mb-1">Texto do Depoimento</label>
                    <textarea
                      rows="2"
                      class="test-input w-full px-2.5 py-1.5 rounded-lg bg-[#1B1815] border border-[#2D2824] focus:border-[#A8382B] text-xs text-white resize-none"
                      data-path={item.path}
                      data-field="quote"
                    >{item.data.quote}</textarea>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- TAB PANEL 8: Contato & Redes -->
          <div id="panel-contact" class="tab-panel hidden p-4 space-y-4">
            <div class="pb-2 border-b border-[#2D2824]">
              <h3 class="text-xs font-bold uppercase tracking-wider text-white">Canais de Contato & Redes</h3>
              <p class="text-[11px] text-[#9E968E] mt-0.5">WhatsApp de recebimento de leads e perfis sociais.</p>
            </div>
            <div class="space-y-3">
              <div>
                <label for="input-contact-fullname" class="block text-[11px] font-bold text-white mb-1">
                  Nome da Criadora
                </label>
                <input
                  type="text"
                  id="input-contact-fullname"
                  value={generalData.fullName}
                  class="w-full px-3 py-2 rounded-xl bg-[#24201C] border border-[#2D2824] focus:border-[#A8382B] text-xs text-white focus:outline-none transition"
                />
              </div>
              <div>
                <label for="input-contact-role" class="block text-[11px] font-bold text-white mb-1">
                  Especialidade / Cargo
                </label>
                <input
                  type="text"
                  id="input-contact-role"
                  value={generalData.role}
                  class="w-full px-3 py-2 rounded-xl bg-[#24201C] border border-[#2D2824] focus:border-[#A8382B] text-xs text-white focus:outline-none transition"
                />
              </div>
              <div>
                <label for="input-contact-instagram" class="block text-[11px] font-bold text-white mb-1">
                  Instagram (@)
                </label>
                <input
                  type="text"
                  id="input-contact-instagram"
                  value={generalData.instagram}
                  class="w-full px-3 py-2 rounded-xl bg-[#24201C] border border-[#2D2824] focus:border-[#A8382B] text-xs text-white focus:outline-none transition"
                />
              </div>
              <div>
                <label for="input-contact-tiktok" class="block text-[11px] font-bold text-white mb-1">
                  TikTok (@)
                </label>
                <input
                  type="text"
                  id="input-contact-tiktok"
                  value={generalData.tiktok}
                  class="w-full px-3 py-2 rounded-xl bg-[#24201C] border border-[#2D2824] focus:border-[#A8382B] text-xs text-white focus:outline-none transition"
                />
              </div>
              <div>
                <label for="input-contact-whatsapp" class="block text-[11px] font-bold text-white mb-1">
                  WhatsApp (DDD + Número)
                </label>
                <input
                  type="text"
                  id="input-contact-whatsapp"
                  value={generalData.whatsappNumber}
                  class="w-full px-3 py-2 rounded-xl bg-[#24201C] border border-[#2D2824] focus:border-[#A8382B] text-xs text-white focus:outline-none transition"
                />
              </div>
            </div>
          </div>

          <!-- TAB PANEL 8: Paleta de Cores -->
          <div id="panel-theme" class="tab-panel hidden p-4 space-y-3">
            <div class="pb-2 border-b border-[#2D2824]">
              <h3 class="text-xs font-bold uppercase tracking-wider text-white">Paleta de Cores do Portfólio</h3>
              <p class="text-[11px] text-[#9E968E] mt-0.5">Selecione para ver a mudança imediata no site.</p>
            </div>
            <div class="space-y-2">
              {palettes.map((p) => {
                const isActive = p.id === currentTheme;
                return (
                  <button
                    type="button"
                    class={`palette-card w-full text-left p-3 rounded-2xl border transition-all cursor-pointer flex items-center justify-between ${
                      isActive
                        ? "border-[#A8382B] bg-[#361A16] active-card"
                        : "border-[#2D2824] hover:border-[#3D3630] bg-[#24201C] hover:bg-[#2D2824]"
                    }`}
                    data-theme={p.id}
                  >
                    <div class="flex items-center gap-3">
                      <div class="flex items-center -space-x-1.5 flex-shrink-0">
                        <span
                          class="w-5 h-5 rounded-full border-2 border-[#1B1815] shadow-sm"
                          style={`background-color: ${p.color1};`}
                        ></span>
                        <span
                          class="w-5 h-5 rounded-full border-2 border-[#1B1815] shadow-sm"
                          style={`background-color: ${p.color2};`}
                        ></span>
                      </div>
                      <div>
                        <span class="block text-xs font-bold text-white">{p.name}</span>
                        <span class="block text-[10px] text-[#9E968E]">{p.subtitle}</span>
                      </div>
                    </div>
                    <span class={`check-icon text-xs text-[#A8382B] font-bold ${isActive ? "" : "hidden"}`}>
                      <EditorIcon name="check" class="w-3.5 h-3.5" />
                    </span>
                  </button>
                );
              })}
            </div>
          </div>
        </div>

        <!-- Sticky Bottom Save Area -->
        <div class="p-3 border-t border-[#2D2824] bg-[#171412] space-y-2 flex-shrink-0 pb-[max(0.75rem,env(safe-area-inset-bottom))]">
          <!-- Mobile Quick Preview Link -->
          <div class="flex items-center justify-between lg:hidden pb-1 pt-0.5">
            <span class="text-[11px] text-[#9E968E]">Edição em tela cheia</span>
            <button
              type="button"
              id="mobile-switch-to-preview-btn"
              class="text-[11px] font-bold text-[#C28D3F] hover:text-white flex items-center gap-1.5 transition cursor-pointer py-1 px-2.5 rounded-lg bg-[#24201C] border border-[#3D3630]"
            >
              <EditorIcon name="eye" class="w-3.5 h-3.5" />
              <span>Ver no Site ↗</span>
            </button>
          </div>

          <div id="pending-badge" class="hidden items-center justify-between text-[11px] text-[#C28D3F] bg-[#24201C] px-3 py-1.5 rounded-xl border border-[#C28D3F]/30 font-semibold">
            <span class="flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-[#C28D3F] animate-pulse"></span>
              <span id="pending-count">1 módulo modificado</span>
            </span>
            <span class="text-[10px] text-[#9E968E]">Pendente</span>
          </div>

          <!-- Auth Status Indicator -->
          <div id="auth-status-container" class="flex items-center justify-between text-[10px] text-[#9E968E] px-1">
            <span class="flex items-center gap-1.5">
              <span id="auth-status-dot" class="w-2 h-2 rounded-full bg-amber-500"></span>
              <span id="auth-status-text">Verificando sessão...</span>
            </span>
            <button
              type="button"
              id="btn-auth-action"
              class="hidden px-2 py-0.5 rounded-lg bg-[#24201C] hover:bg-[#2D2824] border border-[#3D3630] text-[10px] font-bold text-[#C28D3F] hover:text-white transition cursor-pointer"
            >
              Fazer Login ↗
            </button>
          </div>

          <!-- Mobile Quick Switch to Preview Button (Only on < lg) -->
          <button
            type="button"
            id="mobile-switch-to-preview-btn"
            class="lg:hidden w-full py-2 px-3 rounded-xl bg-[#24201C] hover:bg-[#2D2824] text-white font-semibold text-xs transition-all flex items-center justify-center gap-2 cursor-pointer border border-[#3D3630]"
          >
            <EditorIcon name="eye" class="w-3.5 h-3.5 text-[#C28D3F]" />
            <span>Ver Prévia ao Vivo</span>
          </button>

          <!-- Save Button with Solid State -->
          <button
            type="button"
            id="btn-save-all"
            disabled
            class="w-full py-2.5 px-4 rounded-xl bg-[#2D2824] text-[#8A827B] font-bold text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2 cursor-not-allowed border border-transparent select-none"
          >
            <span id="save-btn-text">Nenhuma Alteração</span>
          </button>

          <div id="save-feedback" class="hidden text-center text-[11px] font-semibold py-1.5 px-2.5 rounded-lg"></div>
        </div>
      </aside>

      <!-- Draggable Splitter Divider between Sidebar and Preview (Desktop) -->
      <div
        id="sidebar-splitter"
        class="hidden lg:flex w-2 bg-[#12100E] hover:bg-[#A8382B] active:bg-[#A8382B] cursor-col-resize items-center justify-center border-r border-[#2D2824] transition-colors z-20 group select-none flex-shrink-0"
        title="Arraste para redimensionar a largura do painel"
      >
        <div class="w-0.5 h-8 bg-[#3D3630] group-hover:bg-white rounded-full transition-colors"></div>
      </div>

      <!-- Right Main: Live Preview Frame with Resizable Width Handle -->
      <main id="preview-main" class="flex-1 bg-[#0D0B0A] relative hidden lg:flex flex-col items-center justify-center overflow-hidden p-1 sm:p-5 select-none min-w-0 h-full">
        <!-- Preview Wrapper Container with Drag Handle -->
        <div id="preview-wrapper" class="relative max-w-full max-h-full flex items-center justify-center transition-all duration-150" style="width: 100%; height: 100%;">
          <iframe
            id="preview-frame"
            src={`/?theme=${currentTheme}`}
            class="w-full h-full bg-[#FAF8F5] rounded-xl shadow-2xl transition-all duration-300 border-2 border-[#2D2824]"
            title="Visualização ao Vivo do Portfólio"
          ></iframe>

          <!-- Right Draggable Resize Handle (Only visible on Desktop lg:) -->
          <div
            id="iframe-resizer-right"
            class="hidden lg:flex absolute -right-3.5 top-1/2 -translate-y-1/2 w-4 h-24 bg-[#24201C] hover:bg-[#A8382B] active:bg-[#A8382B] rounded-full border border-[#3D3630] items-center justify-center cursor-ew-resize transition-colors shadow-2xl z-30 group select-none"
            title="Arraste para redimensionar a largura da tela"
          >
            <div class="flex flex-col gap-1 items-center pointer-events-none">
              <span class="w-1 h-1 rounded-full bg-[#9E968E] group-hover:bg-white"></span>
              <span class="w-1 h-1 rounded-full bg-[#9E968E] group-hover:bg-white"></span>
              <span class="w-1 h-1 rounded-full bg-[#9E968E] group-hover:bg-white"></span>
            </div>
          </div>
        </div>

        <!-- Floating Button on Mobile Preview to Return to Editor -->
        <button
          type="button"
          id="mobile-back-to-editor-btn"
          style="display: none;"
          class="lg:hidden fixed bottom-5 right-5 z-40 px-4 py-2.5 rounded-full bg-[#1B1815]/95 hover:bg-[#24201C] text-white border border-[#3D3630] shadow-2xl flex items-center gap-2 text-xs font-bold transition hover:scale-105 active:scale-95 cursor-pointer backdrop-blur-md"
        >
          <EditorIcon name="pencil" class="w-3.5 h-3.5 text-[#C28D3F]" />
          <span>Voltar ao Editor</span>
        </button>
      </main>
    </div>

    <!-- Client-Side Script with Solid State Management -->
    <script>
      import { saveContentFiles, getKeystaticAuth, redirectToLogin } from "../lib/keystaticClient";

      // Elements
      const iframe = document.getElementById("preview-frame") as HTMLIFrameElement;
      const wrapper = document.getElementById("preview-wrapper");
      const previewDimBadge = document.getElementById("preview-dim-badge");
      const iframeResizer = document.getElementById("iframe-resizer-right");
      const sidebarSplitter = document.getElementById("sidebar-splitter");
      const adminSidebar = document.getElementById("admin-sidebar");
      const btnReload = document.getElementById("btn-reload");
      const deviceBtns = document.querySelectorAll(".device-btn");
      const moduleTabs = document.querySelectorAll(".module-tab");
      const tabPanels = document.querySelectorAll(".tab-panel");
      const paletteCards = document.querySelectorAll(".palette-card");
      const btnSaveAll = document.getElementById("btn-save-all") as HTMLButtonElement;
      const saveBtnText = document.getElementById("save-btn-text");
      const pendingBadge = document.getElementById("pending-badge");
      const pendingCount = document.getElementById("pending-count");
      const saveFeedback = document.getElementById("save-feedback");
      const authStatusDot = document.getElementById("auth-status-dot");
      const authStatusText = document.getElementById("auth-status-text");
      const btnAuthAction = document.getElementById("btn-auth-action");
      const mobilePreviewBadge = document.getElementById("mobile-preview-badge");

      // Tabs scroll buttons
      const tabsScrollContainer = document.getElementById("tabs-scroll-container");
      const btnScrollLeft = document.getElementById("tabs-scroll-left");
      const btnScrollRight = document.getElementById("tabs-scroll-right");

      // Inject server-rendered data into client memory
      const initialGeneral = { ...window.__INITIAL_GENERAL__ };
      const currentGeneral = { ...initialGeneral };

      const initialTopbar = { ...window.__INITIAL_TOPBAR__ };
      const currentTopbar = { ...initialTopbar };

      const initialHero = { ...window.__INITIAL_HERO__ };
      const currentHero = { ...initialHero };

      // Collections State Map: path -> data
      const initialCollections = new Map<string, any>();
      const currentCollections = new Map<string, any>();
      const deletedCollections = new Set<string>();

      if (window.__COLLECTIONS__) {
        window.__COLLECTIONS__.forEach((item: { path: string; data: any }) => {
          initialCollections.set(item.path, JSON.parse(JSON.stringify(item.data)));
          currentCollections.set(item.path, JSON.parse(JSON.stringify(item.data)));
        });
      }

      function markCollectionDeleted(path: string) {
        currentCollections.delete(path);
        if (initialCollections.has(path)) {
          deletedCollections.add(path);
        } else {
          deletedCollections.delete(path);
        }
        evaluateChanges();
      }

      function toDirectGoogleDriveUrl(url: string): string {
        if (!url || typeof url !== "string") return url;
        const driveMatch = url.match(/\/file\/d\/([a-zA-Z0-9_-]+)/) || url.match(/[?&]id=([a-zA-Z0-9_-]+)/);
        if (driveMatch) {
          return `https://lh3.googleusercontent.com/d/${driveMatch[1]}`;
        }
        return url;
      }

      // Live update helper for preview iframe via postMessage and DOM manipulation
      function sendLivePreviewUpdate(updateData: any) {
        // 1. PostMessage to iframe window
        if (iframe && iframe.contentWindow) {
          iframe.contentWindow.postMessage({ type: "STUDIO_LIVE_UPDATE", data: updateData }, "*");
        }

        // 2. Direct DOM mutation fallback
        try {
          const doc = iframe?.contentDocument || iframe?.contentWindow?.document;
          if (!doc) return;

          if (updateData.selector && typeof updateData.text === "string") {
            const els = doc.querySelectorAll(updateData.selector);
            els.forEach((el) => {
              el.textContent = updateData.text;
              el.setAttribute("data-pt-text", updateData.text);
            });
          }
          if (updateData.imageSelector && typeof updateData.imageUrl === "string") {
            const img = doc.querySelector(updateData.imageSelector) as HTMLImageElement;
            if (img) img.src = updateData.imageUrl;
          }
          if (updateData.theme) {
            doc.documentElement.setAttribute("data-theme", updateData.theme);
          }

          if (updateData.caseUpdate) {
            const { index, brand, title, stats, badge, highlightMetric, metricLabel, quote, author, thumbnail, youtubeId } = updateData.caseUpdate;
            const card = doc.querySelector(`.case-card[data-index="${index}"]`);
            if (card) {
              if (brand) {
                const bEl = card.querySelector(".inline-block.self-start");
                if (bEl) bEl.textContent = brand;
              }
              if (title) {
                const tEl = card.querySelector("p.text-xs.font-bold");
                if (tEl) tEl.textContent = title;
              }
              if (stats) {
                const sEl = card.querySelector("span.text-\\[\\#C28D3F\\]") || card.querySelector(".text-\\[11px\\]");
                if (sEl) sEl.textContent = stats;
              }
              if (thumbnail) {
                const img = card.querySelector("img");
                if (img) img.src = thumbnail;
              }
              if (youtubeId) {
                card.setAttribute("data-youtube", youtubeId);
              }
            }

            const narr = doc.querySelector(`.case-narrative[data-narrative-index="${index}"]`);
            if (narr) {
              if (badge) {
                const bBadge = narr.querySelector(`[data-i18n="case.${index + 1}.badge"]`) || narr.querySelector(".rounded-full span");
                if (bBadge) bBadge.textContent = badge;
              }
              if (brand) {
                const h3 = narr.querySelector("h3");
                if (h3) h3.textContent = brand;
              }
              if (highlightMetric) {
                const mVal = narr.querySelector(".font-impact.font-bold.text-\\[\\#A8382B\\]") || narr.querySelector(".font-impact.text-\\[\\#A8382B\\]");
                if (mVal) mVal.textContent = highlightMetric;
              }
              if (metricLabel) {
                const mLbl = narr.querySelector(`[data-i18n="case.${index + 1}.metricLabel"]`) || narr.querySelector(".text-lg.font-bold.text-\\[\\#1B1815\\]");
                if (mLbl) mLbl.textContent = metricLabel;
              }
              if (quote) {
                const qEl = narr.querySelector(`[data-i18n="case.${index + 1}.quote"]`) || narr.querySelector("blockquote p, blockquote, .italic span");
                if (qEl) qEl.textContent = quote.startsWith('"') ? quote : `"${quote}"`;
              }
              if (author) {
                const aEl = narr.querySelector(`[data-i18n="case.${index + 1}.author"]`) || narr.querySelector("cite, .not-italic");
                if (aEl) aEl.textContent = author.startsWith("—") ? author : `— ${author}`;
              }
            }
          }

          if (updateData.serviceUpdate) {
            const { index, title, shortDesc, deliverables, idealFor } = updateData.serviceUpdate;
            const serviceCards = doc.querySelectorAll("#servicos .lg\\:col-span-7 > div");
            const card = serviceCards[index];
            if (card) {
              if (title) {
                const h3 = card.querySelector("h3");
                if (h3) h3.textContent = title;
              }
              if (shortDesc) {
                const p = card.querySelector("p.text-sm");
                if (p) p.textContent = shortDesc;
              }
              if (deliverables) {
                const container = card.querySelector(".flex.flex-wrap.gap-2");
                if (container) {
                  const items = deliverables.split(",").map((s: string) => s.trim()).filter(Boolean);
                  container.innerHTML = items.map((it: string) => `<span class="px-2.5 py-1 rounded-lg bg-white border border-[#1B1815]/10 text-xs font-medium text-[#57524C]">• ${it}</span>`).join("");
                }
              }
              if (idealFor) {
                const idealEl = card.querySelector(".pt-4.border-t");
                if (idealEl) idealEl.innerHTML = `<span class="font-bold text-[#1B1815]">Ideal para:</span> ${idealFor}`;
              }
            }
          }

          if (updateData.testUpdate) {
            const { index, clientName, brand, role, quote } = updateData.testUpdate;
            const testCards = doc.querySelectorAll("#depoimentos .grid > div");
            const card = testCards[index];
            if (card) {
              if (quote) {
                const q = card.querySelector("blockquote");
                if (q) q.textContent = quote.startsWith('"') ? quote : `"${quote}"`;
              }
              if (clientName) {
                const n = card.querySelector("span.text-xs.font-bold");
                if (n) n.textContent = clientName;
              }
              if (brand || role) {
                const r = card.querySelector("span.text-\\[11px\\]");
                if (r) r.innerHTML = `${role || ""} · <strong class="text-[#A8382B]">${brand || ""}</strong>`;
              }
            }
          }

          if (updateData.brandsUpdate && Array.isArray(updateData.brandsUpdate)) {
            const marqueeTrack = doc.querySelector("#marcas .animate-marquee-left");
            if (marqueeTrack) {
              const list = updateData.brandsUpdate.filter((b: any) => b.name && b.name.trim());
              if (list.length > 0) {
                const repeat = Math.max(2, Math.ceil(18 / list.length));
                const repeated = Array.from({ length: repeat }, () => list).flat();
                marqueeTrack.innerHTML = repeated.map((b: any) => `
                  <div class="inline-flex items-center gap-10 text-xs sm:text-sm font-impact uppercase tracking-widest text-[#FAF8F5]/90 hover:text-[#C28D3F] transition-colors cursor-default">
                    <span>${b.name}</span>
                    <span class="text-[#A8382B] text-xs font-serif">◆</span>
                  </div>
                `).join("");
              }
            }
          }

          if (updateData.creatorUpdate) {
            const { fullName, instagram } = updateData.creatorUpdate;
            if (fullName) {
              const parts = fullName.trim().split(" ");
              const firstName = parts[0] || "";
              const lastName = parts.slice(1).join(" ") || "";
              const headerLogo = doc.querySelector("nav a.font-serif-editorial");
              if (headerLogo) {
                const spans = headerLogo.querySelectorAll("span");
                if (spans[0]) spans[0].textContent = firstName;
                if (spans[1]) spans[1].textContent = lastName;
              }
              const footerName = doc.querySelector("footer .font-serif-editorial");
              if (footerName) footerName.textContent = fullName;
            }
            if (instagram) {
              const instaLinks = doc.querySelectorAll('a[href*="instagram.com"]');
              instaLinks.forEach((a) => {
                (a as HTMLAnchorElement).href = `https://instagram.com/${instagram.replace("@", "")}`;
                const textSpan = a.querySelector("span.text-xs");
                if (textSpan) textSpan.textContent = instagram.startsWith("@") ? instagram : `@${instagram}`;
              });
            }
          }
        } catch (e) {}
      }

      function updateIframeText(selector: string, text: string) {
        sendLivePreviewUpdate({ selector, text });
      }

      // Auth UI Setup
      function updateAuthUI() {
        const auth = getKeystaticAuth();
        const isDev = window.location.hostname === "localhost" || window.location.hostname === "127.0.0.1";

        const headerLoginBtn = document.getElementById("header-login-btn");
        const headerAuthBadge = document.getElementById("header-auth-badge");
        const authWarningBanner = document.getElementById("auth-warning-banner");
        const bannerLoginBtn = document.getElementById("banner-login-btn");

        if (isDev) {
          if (authStatusDot) authStatusDot.className = "w-2 h-2 rounded-full bg-emerald-500";
          if (authStatusText) authStatusText.textContent = "Modo Local (Dev)";
          if (btnAuthAction) btnAuthAction.style.display = "none";
          if (headerLoginBtn) headerLoginBtn.style.display = "none";
          if (headerAuthBadge) {
            headerAuthBadge.style.display = "inline-flex";
            headerAuthBadge.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-500"></span><span>Modo Local</span>';
          }
          if (authWarningBanner) authWarningBanner.style.display = "none";
        } else if (auth.isAuthenticated) {
          if (authStatusDot) authStatusDot.className = "w-2 h-2 rounded-full bg-emerald-500";
          if (authStatusText) authStatusText.textContent = "Conectado ao Studio";
          if (btnAuthAction) btnAuthAction.style.display = "none";
          if (headerLoginBtn) headerLoginBtn.style.display = "none";
          if (headerAuthBadge) {
            headerAuthBadge.style.display = "inline-flex";
            headerAuthBadge.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-500"></span><span>Conectado</span>';
          }
          if (authWarningBanner) authWarningBanner.style.display = "none";
        } else {
          if (authStatusDot) authStatusDot.className = "w-2 h-2 rounded-full bg-amber-500 animate-pulse";
          if (authStatusText) authStatusText.textContent = "Sessão Desconectada";
          if (btnAuthAction) {
            btnAuthAction.style.display = "inline-block";
            btnAuthAction.onclick = () => redirectToLogin();
          }
          if (headerLoginBtn) {
            headerLoginBtn.style.display = "inline-flex";
            headerLoginBtn.onclick = () => redirectToLogin();
          }
          if (headerAuthBadge) {
            headerAuthBadge.style.display = "none";
          }
          if (authWarningBanner) {
            authWarningBanner.style.display = "block";
            if (bannerLoginBtn) {
              bannerLoginBtn.onclick = () => redirectToLogin();
            }
          }
        }
      }

      updateAuthUI();
      window.addEventListener("storage", updateAuthUI);
      window.addEventListener("focus", updateAuthUI);

      // Horizontal Tabs Scroll buttons & Wheel scroll
      btnScrollLeft?.addEventListener("click", () => {
        tabsScrollContainer?.scrollBy({ left: -140, behavior: "smooth" });
      });

      btnScrollRight?.addEventListener("click", () => {
        tabsScrollContainer?.scrollBy({ left: 140, behavior: "smooth" });
      });

      tabsScrollContainer?.addEventListener("wheel", (e) => {
        if (e.deltaY !== 0) {
          e.preventDefault();
          tabsScrollContainer.scrollLeft += e.deltaY;
        }
      }, { passive: false });

      // --- UNIFIED TAB ACTIVATION & BIDIRECTIONAL SCROLL-SPY ---
      let isProgrammaticScroll = false;
      let scrollTimeout: any = null;
      let lastSpiedSection = "";

      const sectionToTabMap: Record<string, string> = {
        hero: "hero",
        marcas: "brands",
        cases: "cases",
        servicos: "services",
        depoimentos: "testimonials",
        contato: "contact",
      };

      function activateTab(targetTab: string, scrollIframe: boolean = true) {
        const targetBtn = document.querySelector(`.module-tab[data-tab="${targetTab}"]`);
        if (!targetBtn) return;

        moduleTabs.forEach((t) => {
          t.classList.remove("active", "bg-[#24201C]", "text-white", "border-[#3D3630]");
          t.classList.add("text-[#9E968E]", "border-transparent");
        });

        targetBtn.classList.remove("text-[#9E968E]", "border-transparent");
        targetBtn.classList.add("active", "bg-[#24201C]", "text-white", "border-[#3D3630]");

        // Ensure the active tab button is scrolled into view in the horizontal tabs bar
        if (tabsScrollContainer) {
          const btnEl = targetBtn as HTMLElement;
          const containerLeft = tabsScrollContainer.scrollLeft;
          const containerWidth = tabsScrollContainer.clientWidth;
          const btnLeft = btnEl.offsetLeft;
          const btnWidth = btnEl.offsetWidth;

          if (btnLeft < containerLeft || btnLeft + btnWidth > containerLeft + containerWidth) {
            tabsScrollContainer.scrollTo({
              left: Math.max(0, btnLeft - 20),
              behavior: "smooth",
            });
          }
        }

        tabPanels.forEach((panel) => {
          panel.classList.add("hidden");
        });

        const activePanel = document.getElementById(`panel-${targetTab}`);
        if (activePanel) {
          activePanel.classList.remove("hidden");
        }

        if (scrollIframe) {
          const targetAnchor = targetBtn.getAttribute("data-target-anchor");
          if (targetAnchor === "top") {
            if (iframe && iframe.contentWindow) {
              isProgrammaticScroll = true;
              clearTimeout(scrollTimeout);
              scrollTimeout = setTimeout(() => {
                isProgrammaticScroll = false;
              }, 900);
              iframe.contentWindow.scrollTo({
                top: 0,
                behavior: "smooth",
              });
            }
          } else if (targetAnchor && iframe && iframe.contentWindow) {
            try {
              const doc = iframe.contentWindow.document;
              const el = doc.getElementById(targetAnchor);
              if (el) {
                isProgrammaticScroll = true;
                clearTimeout(scrollTimeout);
                scrollTimeout = setTimeout(() => {
                  isProgrammaticScroll = false;
                }, 900);

                const elTop = el.getBoundingClientRect().top + iframe.contentWindow.scrollY;
                iframe.contentWindow.scrollTo({
                  top: Math.max(0, elTop - 24),
                  behavior: "smooth",
                });
              }
            } catch (e) {}
          }
        }
      }

      // User tab click
      moduleTabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const targetTab = tab.getAttribute("data-tab");
          if (targetTab) activateTab(targetTab, true);
        });
      });

      // Scroll Spy: Listening to Iframe Scroll to update active Editor Tab
      function setupIframeScrollSpy() {
        if (!iframe || !iframe.contentWindow) return;
        try {
          const iframeWin = iframe.contentWindow;
          const iframeDoc = iframe.contentDocument;
          if (!iframeDoc) return;

          const sectionIds = ["hero", "marcas", "cases", "servicos", "depoimentos", "contato"];

          const handleIframeScroll = () => {
            if (isProgrammaticScroll) return;

            const scrollY = iframeWin.scrollY;
            if (scrollY < 20) {
              if (lastSpiedSection !== "topbar") {
                lastSpiedSection = "topbar";
                activateTab("topbar", false);
              }
              return;
            }
            if (scrollY < 80) {
              if (lastSpiedSection !== "hero") {
                lastSpiedSection = "hero";
                activateTab("hero", false);
              }
              return;
            }

            const viewportAnchor = scrollY + (iframeWin.innerHeight * 0.35);
            let matchedSection = "";

            for (const sId of sectionIds) {
              const el = iframeDoc.getElementById(sId);
              if (!el) continue;
              const top = el.offsetTop;
              const bottom = top + el.offsetHeight;

              if (viewportAnchor >= top && viewportAnchor < bottom) {
                matchedSection = sId;
                break;
              }
            }

            if (matchedSection && matchedSection !== lastSpiedSection) {
              lastSpiedSection = matchedSection;
              const mappedTab = sectionToTabMap[matchedSection];
              if (mappedTab) {
                activateTab(mappedTab, false);
              }
            }
          };

          iframeWin.removeEventListener("scroll", handleIframeScroll);
          iframeWin.addEventListener("scroll", handleIframeScroll, { passive: true });
        } catch (e) {}
      }

      iframe.addEventListener("load", setupIframeScrollSpy);

      // Quick Scroll to Card Buttons inside panels (strictly scroll panels-container, never parent page)
      const panelsContainer = document.getElementById("panels-container");
      document.querySelectorAll(".scroll-to-card-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const targetId = btn.getAttribute("data-target");
          if (!targetId) return;
          const targetCard = document.getElementById(targetId);
          if (targetCard && panelsContainer) {
            const cardTop = targetCard.offsetTop;
            panelsContainer.scrollTo({
              top: Math.max(0, cardTop - 12),
              behavior: "smooth",
            });
            targetCard.classList.add("border-[#A8382B]", "ring-2", "ring-[#A8382B]/40");
            setTimeout(() => {
              targetCard.classList.remove("border-[#A8382B]", "ring-2", "ring-[#A8382B]/40");
            }, 1500);
          }
        });
      });

      // Dirty Tracking & Save Button State
      function evaluateChanges() {
        let changedCount = 0;

        const isGeneralChanged = JSON.stringify(currentGeneral) !== JSON.stringify(initialGeneral);
        const isTopbarChanged = JSON.stringify(currentTopbar) !== JSON.stringify(initialTopbar);
        const isHeroChanged = JSON.stringify(currentHero) !== JSON.stringify(initialHero);

        if (isGeneralChanged) changedCount++;
        if (isTopbarChanged) changedCount++;
        if (isHeroChanged) changedCount++;

        // Check collections
        let collectionsChanged = 0;
        currentCollections.forEach((currData, path) => {
          if (deletedCollections.has(path)) return;
          const initData = initialCollections.get(path);
          if (!initData || JSON.stringify(currData) !== JSON.stringify(initData)) {
            collectionsChanged++;
          }
        });

        const totalChanged = changedCount + collectionsChanged + deletedCollections.size;

        if (totalChanged > 0) {
          if (pendingBadge) {
            pendingBadge.classList.remove("hidden");
            pendingBadge.classList.add("flex");
          }
          if (pendingCount) {
            pendingCount.textContent = `${totalChanged} item${totalChanged > 1 ? "ns" : ""} modificado${totalChanged > 1 ? "s" : ""}`;
          }
          if (mobilePreviewBadge) {
            mobilePreviewBadge.classList.remove("hidden");
          }

          if (btnSaveAll && saveBtnText) {
            btnSaveAll.disabled = false;
            btnSaveAll.className = "w-full py-2.5 px-4 rounded-xl bg-[#A8382B] hover:bg-[#82271D] text-white font-bold text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2 cursor-pointer shadow-lg shadow-[#A8382B]/20 border border-[#C28D3F]/40";
            saveBtnText.textContent = "Salvar e Publicar no Site";
          }
        } else {
          if (pendingBadge) {
            pendingBadge.classList.add("hidden");
            pendingBadge.classList.remove("flex");
          }
          if (mobilePreviewBadge) {
            mobilePreviewBadge.classList.add("hidden");
          }

          if (btnSaveAll && saveBtnText) {
            btnSaveAll.disabled = true;
            btnSaveAll.className = "w-full py-2.5 px-4 rounded-xl bg-[#2D2824] text-[#8A827B] font-bold text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2 cursor-not-allowed border border-transparent select-none";
            saveBtnText.textContent = "Nenhuma Alteração";
          }
        }

        return { isGeneralChanged, isTopbarChanged, isHeroChanged, totalChanged };
      }

      // --- MODULE 1: PALETTE SWATCHES ---
      paletteCards.forEach((card) => {
        card.addEventListener("click", () => {
          const theme = card.getAttribute("data-theme") || "terracotta";
