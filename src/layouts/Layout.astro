---
import "../styles/global.css";
import { portfolioData } from "../data/portfolioData";
import ThemePreviewer from "../components/ThemePreviewer.astro";
import LegalModal from "../components/LegalModal.astro";
import CookieBanner from "../components/CookieBanner.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = `${portfolioData.creator.fullName} | Criadora de Conteúdo UGC & Estrategista de Criativos`,
  description = "Portfólio oficial de Amanda Lopes, criadora UGC. Vídeos autênticos para Meta Ads, TikTok e Reels focados em retenção, provas sociais e alta conversão para marcas.",
  image = portfolioData.hero.photoUrl,
} = Astro.props;

const siteUrl = "https://amandaugc.com.br";

// Schema.org Structured Data (JSON-LD) for Google Rich Snippets & Person/CreativeWork
const schemaOrgPerson = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": portfolioData.creator.fullName,
  "jobTitle": portfolioData.creator.role,
  "url": siteUrl,
  "sameAs": [
    `https://instagram.com/${portfolioData.creator.instagram.replace('@', '')}`,
    `https://tiktok.com/@${portfolioData.creator.tiktok.replace('@', '')}`
  ],
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "São Paulo",
    "addressRegion": "SP",
    "addressCountry": "BR"
  },
  "knowsAbout": [
    "User Generated Content (UGC)",
    "Video Marketing",
    "Meta Ads",
    "TikTok Ads",
    "E-commerce Conversion"
  ]
};
---

<!doctype html>
<html lang="pt-BR" data-theme={portfolioData.theme || "terracotta"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={portfolioData.creator.fullName} />
    <meta name="keywords" content="UGC, UGC creator, criador de conteúdo UGC, anúncios TikTok, criativos Reels, vídeos para tráfego pago, Amanda Lopes UGC, marketing de influência" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#FAF8F5" />
    <link rel="canonical" href={siteUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={portfolioData.creator.fullName} />

    <!-- Twitter Cards -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={siteUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Favicon -->
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>✨</text></svg>"
    />

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Allura&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,400&family=League+Spartan:wght@500;600;700;800&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD Structured Data for Google -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrgPerson)} />
  </head>
  <body class="min-h-screen selection:bg-[#A8382B]/20 selection:text-[#82271D]">
    <!-- Accessibility Skip Link -->
    <a href="#conteudo-principal" class="skip-link">Pular para o conteúdo principal</a>

    <slot />

    <ThemePreviewer />
    <LegalModal />
    <CookieBanner />

    <!-- Global Video Lightbox Modal Component -->
    <div
      id="video-lightbox"
      class="fixed inset-0 z-50 hidden items-center justify-center bg-black/85 p-4 backdrop-blur-md transition-opacity duration-300"
      role="dialog"
      aria-modal="true"
      aria-label="Reprodutor de vídeo em tela cheia"
    >
      <div class="relative w-full max-w-sm aspect-[9/16] overflow-hidden rounded-2xl bg-black shadow-2xl">
        <button
          type="button"
          id="close-lightbox"
          class="absolute top-4 right-4 z-20 flex h-10 w-10 items-center justify-center rounded-full bg-white/20 text-white backdrop-blur-md transition hover:bg-white/40 cursor-pointer"
          aria-label="Fechar reprodutor de vídeo (ESC)"
        >
          <svg
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"
            />
          </svg>
        </button>
        <iframe
          id="lightbox-iframe"
          class="h-full w-full border-0"
          src=""
          title="Vídeo demonstrativo do portfólio"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    </div>

    <script>
      // Global Lightbox handlers
      const lightbox = document.getElementById("video-lightbox");
      const iframe = document.getElementById("lightbox-iframe") as HTMLIFrameElement;
      const closeBtn = document.getElementById("close-lightbox");

      // Helper para converter links do Google Drive, YouTube ou diretos em URL de player embed
      function resolveVideoEmbedUrl(source: string): string {
        if (!source) return "";
        const trimmed = source.trim();

        // 1. Link do Google Drive (ex: https://drive.google.com/file/d/1XyZ.../view?usp=sharing)
        const driveMatch = trimmed.match(/\/file\/d\/([a-zA-Z0-9_-]+)/) || trimmed.match(/[?&]id=([a-zA-Z0-9_-]+)/);
        if (driveMatch) {
          return `https://drive.google.com/file/d/${driveMatch[1]}/preview`;
        }

        // 2. Link completo do YouTube (shorts, watch?v=, youtu.be, embed)
        const ytMatch = trimmed.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|shorts\/))([a-zA-Z0-9_-]{11})/);
        if (ytMatch) {
          return `https://www.youtube-nocookie.com/embed/${ytMatch[1]}?autoplay=1&rel=0&modestbranding=1`;
        }

        // 3. Link direto HTTP/HTTPS (Vimeo, Cloudinary, etc.)
        if (trimmed.startsWith("http://") || trimmed.startsWith("https://")) {
          return trimmed;
        }

        // 4. Padrão: ID de 11 caracteres do YouTube
        return `https://www.youtube-nocookie.com/embed/${trimmed}?autoplay=1&rel=0&modestbranding=1`;
      }

      window.openVideoLightbox = (videoSource: string) => {
        if (!lightbox || !iframe) return;
        iframe.src = resolveVideoEmbedUrl(videoSource);
        lightbox.classList.remove("hidden");
        lightbox.classList.add("flex");
        lightbox.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
        closeBtn?.focus();
      };

      const closeLightbox = () => {
        if (!lightbox || !iframe) return;
        iframe.src = "";
        lightbox.classList.add("hidden");
        lightbox.classList.remove("flex");
        lightbox.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "auto";
      };

      closeBtn?.addEventListener("click", closeLightbox);
      lightbox?.addEventListener("click", (e) => {
        if (e.target === lightbox) closeLightbox();
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeLightbox();
      });

      declare global {
        interface Window {
          openVideoLightbox: (youtubeId: string) => void;
        }
      }

      // Allow live palette preview via ?theme=... query param
      const urlParams = new URLSearchParams(window.location.search);
      const previewTheme = urlParams.get("theme");
      const validThemes = ["terracotta", "rose", "monochrome", "olive", "mocha"];
      if (previewTheme && validThemes.includes(previewTheme)) {
        document.documentElement.setAttribute("data-theme", previewTheme);
      }

      // Check Keystatic authentication to reveal admin-only elements
      function checkAdminAuth() {
        const isDev = window.location.hostname === "localhost" || window.location.hostname === "127.0.0.1";
        let isAuthed = isDev;
        try {
          const raw = localStorage.getItem("keystatic-cloud-access-token");
          if (raw) {
            const parsed = JSON.parse(raw);
            if (parsed.token && (!parsed.validUntil || parsed.validUntil > Date.now())) {
              isAuthed = true;
            }
          }
        } catch {}

        if (isAuthed) {
          document.querySelectorAll("[data-admin-only]").forEach((el) => {
            el.classList.remove("hidden");
          });
        }
      }

      checkAdminAuth();
      window.addEventListener("storage", checkAdminAuth);

      // --- STUDIO LIVE PREVIEW BRIDGE (/admin) ---
      window.addEventListener("message", (event) => {
        const { type, data } = event.data || {};
        if (type !== "STUDIO_LIVE_UPDATE" || !data) return;

        // 1. Text selector updates
        if (data.selector && typeof data.text === "string") {
          const els = document.querySelectorAll(data.selector);
          els.forEach((el) => {
            el.textContent = data.text;
            el.setAttribute("data-pt-text", data.text);
          });
        }

        // 2. Image updates
        if (data.imageSelector && typeof data.imageUrl === "string") {
          const img = document.querySelector(data.imageSelector) as HTMLImageElement;
          if (img) img.src = data.imageUrl;
        }

        // 3. Theme update
        if (data.theme) {
          document.documentElement.setAttribute("data-theme", data.theme);
        }

        // 4. Case card updates
        if (data.caseUpdate) {
          const { index, brand, title, stats, badge, highlightMetric, metricLabel, quote, author, thumbnail, youtubeId } = data.caseUpdate;
          const card = document.querySelector(`.case-card[data-index="${index}"]`);
          if (card) {
            if (brand) {
              const bEl = card.querySelector(".inline-block.self-start");
              if (bEl) bEl.textContent = brand;
            }
            if (title) {
              const tEl = card.querySelector("p.text-xs.font-bold");
              if (tEl) tEl.textContent = title;
            }
            if (stats) {
              const sEl = card.querySelector("span.text-\\[\\#C28D3F\\]") || card.querySelector(".text-\\[11px\\]");
              if (sEl) sEl.textContent = stats;
            }
            if (thumbnail) {
              const img = card.querySelector("img");
              if (img) img.src = thumbnail;
            }
            if (youtubeId) {
              card.setAttribute("data-youtube", youtubeId);
            }
          }

          const narr = document.querySelector(`.case-narrative[data-narrative-index="${index}"]`);
          if (narr) {
            if (badge) {
              const bBadge = narr.querySelector(`[data-i18n="case.${index + 1}.badge"]`) || narr.querySelector(".rounded-full span");
              if (bBadge) {
                bBadge.textContent = badge;
                bBadge.setAttribute("data-pt-text", badge);
              }
            }
            if (brand) {
              const h3 = narr.querySelector("h3");
              if (h3) h3.textContent = brand;
            }
            if (highlightMetric) {
              const mVal = narr.querySelector(".font-impact.font-bold.text-\\[\\#A8382B\\]") || narr.querySelector(".font-impact.text-\\[\\#A8382B\\]");
              if (mVal) mVal.textContent = highlightMetric;
            }
            if (metricLabel) {
              const mLbl = narr.querySelector(`[data-i18n="case.${index + 1}.metricLabel"]`) || narr.querySelector(".text-lg.font-bold.text-\\[\\#1B1815\\]");
              if (mLbl) {
                mLbl.textContent = metricLabel;
                mLbl.setAttribute("data-pt-text", metricLabel);
              }
            }
            if (quote) {
              const qEl = narr.querySelector(`[data-i18n="case.${index + 1}.quote"]`) || narr.querySelector("blockquote p, blockquote, .italic span");
              if (qEl) {
                const formattedQuote = quote.startsWith('"') ? quote : `"${quote}"`;
                qEl.textContent = formattedQuote;
                qEl.setAttribute("data-pt-text", formattedQuote);
              }
            }
            if (author) {
              const aEl = narr.querySelector(`[data-i18n="case.${index + 1}.author"]`) || narr.querySelector("cite, .not-italic");
              if (aEl) {
                const formattedAuthor = author.startsWith("—") ? author : `— ${author}`;
                aEl.textContent = formattedAuthor;
                aEl.setAttribute("data-pt-text", formattedAuthor);
              }
            }
          }
        }

        // 5. Service card updates
        if (data.serviceUpdate) {
          const { index, title, shortDesc, deliverables, idealFor } = data.serviceUpdate;
          const serviceCards = document.querySelectorAll("#servicos .lg\\:col-span-7 > div");
          const card = serviceCards[index];
          if (card) {
            if (title) {
              const h3 = card.querySelector("h3");
              if (h3) h3.textContent = title;
            }
            if (shortDesc) {
              const p = card.querySelector("p.text-sm");
              if (p) p.textContent = shortDesc;
            }
            if (deliverables) {
              const container = card.querySelector(".flex.flex-wrap.gap-2");
              if (container) {
                const items = deliverables.split(",").map((s: string) => s.trim()).filter(Boolean);
                container.innerHTML = items.map((it: string) => `<span class="px-2.5 py-1 rounded-lg bg-white border border-[#1B1815]/10 text-xs font-medium text-[#57524C]">• ${it}</span>`).join("");
              }
            }
            if (idealFor) {
              const idealEl = card.querySelector(".pt-4.border-t");
              if (idealEl) idealEl.innerHTML = `<span class="font-bold text-[#1B1815]">Ideal para:</span> ${idealFor}`;
            }
          }
        }

        // 6. Testimonial card updates
        if (data.testUpdate) {
          const { index, clientName, brand, role, quote } = data.testUpdate;
          const testCards = document.querySelectorAll("#depoimentos .grid > div");
          const card = testCards[index];
          if (card) {
            if (quote) {
              const q = card.querySelector("blockquote");
              if (q) q.textContent = quote.startsWith('"') ? quote : `"${quote}"`;
            }
            if (clientName) {
              const n = card.querySelector("span.text-xs.font-bold");
              if (n) n.textContent = clientName;
            }
            if (brand || role) {
              const r = card.querySelector("span.text-\\[11px\\]");
              if (r) r.innerHTML = `${role || ""} · <strong class="text-[#A8382B]">${brand || ""}</strong>`;
            }
          }
        }

        // 7. Brands marquee updates
        if (data.brandsUpdate && Array.isArray(data.brandsUpdate)) {
          const marqueeTrack = document.querySelector("#marcas .animate-marquee-left");
          if (marqueeTrack) {
            const list = data.brandsUpdate.filter((b: any) => b.name && b.name.trim());
            if (list.length > 0) {
              const repeat = Math.max(2, Math.ceil(18 / list.length));
              const repeated = Array.from({ length: repeat }, () => list).flat();
              marqueeTrack.innerHTML = repeated.map((b: any) => `
                <div class="inline-flex items-center gap-10 text-xs sm:text-sm font-impact uppercase tracking-widest text-[#FAF8F5]/90 hover:text-[#C28D3F] transition-colors cursor-default">
                  <span>${b.name}</span>
                  <span class="text-[#A8382B] text-xs font-serif">◆</span>
                </div>
              `).join("");
            }
          }
        }

        // 8. Creator / Identity updates
        if (data.creatorUpdate) {
          const { fullName, role, instagram } = data.creatorUpdate;
          if (fullName) {
            const parts = fullName.trim().split(" ");
            const firstName = parts[0] || "";
            const lastName = parts.slice(1).join(" ") || "";
            const headerLogo = document.querySelector("nav a.font-serif-editorial");
            if (headerLogo) {
              const spans = headerLogo.querySelectorAll("span");
              if (spans[0]) spans[0].textContent = firstName;
              if (spans[1]) spans[1].textContent = lastName;
            }
            const footerName = document.querySelector("footer .font-serif-editorial");
            if (footerName) footerName.textContent = fullName;
          }
          if (instagram) {
            const instaLinks = document.querySelectorAll('a[href*="instagram.com"]');
            instaLinks.forEach((a) => {
              (a as HTMLAnchorElement).href = `https://instagram.com/${instagram.replace("@", "")}`;
              const textSpan = a.querySelector("span.text-xs");
              if (textSpan) textSpan.textContent = instagram.startsWith("@") ? instagram : `@${instagram}`;
            });
          }
        }
      });
    </script>
  </body>
</html>
