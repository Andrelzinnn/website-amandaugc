---
interface Props {
  testimonialsList: Array<{
    path: string;
    data: {
      clientName?: string;
      brand?: string;
      role?: string;
      quote?: string;
    };
  }>;
}

const { testimonialsList } = Astro.props;
---

<div id="panel-testimonials" class="tab-panel hidden p-4 space-y-4">
  <div class="pb-2 border-b border-[#2D2824] flex items-center justify-between">
    <div>
      <h3 class="text-xs font-bold uppercase tracking-wider text-white">Depoimentos de Clientes</h3>
      <p class="text-[11px] text-[#9E968E] mt-0.5">Avaliações das marcas parceiras.</p>
    </div>
    <button
      type="button"
      id="btn-add-testimonial"
      class="px-2.5 py-1 rounded-lg bg-[#A8382B] hover:bg-[#82271D] text-white text-[11px] font-bold transition flex items-center gap-1 cursor-pointer shadow-sm"
    >
      + Novo Depoimento
    </button>
  </div>

  <!-- Quick Navigation Pills to jump to any testimonial card -->
  <div id="testimonials-pills-container" class="flex items-center gap-1.5 overflow-x-auto pb-1 no-scrollbar">
    <span class="text-[10px] text-[#8A827B] uppercase font-bold flex-shrink-0">Pular para:</span>
    {testimonialsList.map((item, idx) => (
      <button
        type="button"
        class="scroll-to-card-btn px-2.5 py-1 rounded-lg bg-[#24201C] hover:bg-[#2D2824] text-[11px] font-semibold text-[#FAF8F5] border border-[#2D2824] hover:border-[#A8382B] transition cursor-pointer flex-shrink-0"
        data-target={`card-test-${idx}`}
      >
        {item.data.clientName?.split(" ")[0] || `Depoimento ${idx + 1}`}
      </button>
    ))}
  </div>

  <div id="testimonials-list-container" class="space-y-4">
    {testimonialsList.map((item, idx) => (
      <div id={`card-test-${idx}`} class="testimonial-card-item p-3.5 rounded-2xl bg-[#24201C] border border-[#2D2824] space-y-2.5 transition-all scroll-mt-2" data-path={item.path}>
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-white truncate max-w-[200px] test-card-client-display">{item.data.clientName || "Novo Depoimento"}</span>
          <button
            type="button"
            class="btn-delete-testimonial p-1 rounded-lg text-[#8A827B] hover:text-red-400 hover:bg-red-950 transition cursor-pointer"
            data-path={item.path}
            title="Excluir este depoimento"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
          </button>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block text-[10px] font-bold text-[#8A827B] mb-1">Nome do Cliente</label>
            <input
              type="text"
              class="test-input w-full px-2.5 py-1.5 rounded-lg bg-[#1B1815] border border-[#2D2824] focus:border-[#A8382B] text-xs text-white"
              data-path={item.path}
              data-field="clientName"
              value={item.data.clientName}
            />
          </div>
          <div>
            <label class="block text-[10px] font-bold text-[#8A827B] mb-1">Empresa / Marca</label>
            <input
              type="text"
              class="test-input w-full px-2.5 py-1.5 rounded-lg bg-[#1B1815] border border-[#2D2824] focus:border-[#A8382B] text-xs text-white"
              data-path={item.path}
              data-field="brand"
              value={item.data.brand}
            />
          </div>
        </div>
        <div>
          <label class="block text-[10px] font-bold text-[#8A827B] mb-1">Cargo</label>
          <input
            type="text"
            class="test-input w-full px-2.5 py-1.5 rounded-lg bg-[#1B1815] border border-[#2D2824] focus:border-[#A8382B] text-xs text-white"
            data-path={item.path}
            data-field="role"
            value={item.data.role}
          />
        </div>
        <div>
          <label class="block text-[10px] font-bold text-[#8A827B] mb-1">Texto do Depoimento</label>
          <textarea
            rows="2"
            class="test-input w-full px-2.5 py-1.5 rounded-lg bg-[#1B1815] border border-[#2D2824] focus:border-[#A8382B] text-xs text-white resize-none"
            data-path={item.path}
            data-field="quote"
          >{item.data.quote}</textarea>
        </div>
      </div>
    ))}
  </div>
</div>
