---
interface Props {
  casesList: Array<{
    path: string;
    data: {
      brand?: string;
      stats?: string;
      title?: string;
      highlightMetric?: string;
      metricLabel?: string;
      quote?: string;
      author?: string;
      youtubeId?: string;
      thumbnail?: string;
    };
  }>;
}

const { casesList } = Astro.props;
---

<div id="panel-cases" class="tab-panel hidden p-4 space-y-4">
  <div class="pb-2 border-b border-[#2D2824] flex items-center justify-between">
    <div>
      <h3 class="text-xs font-bold uppercase tracking-wider text-white">Cases em Destaque (Deck 3D)</h3>
      <p class="text-[11px] text-[#9E968E] mt-0.5">Campanhas e resultados de alto impacto.</p>
    </div>
    <button
      type="button"
      id="btn-add-case"
      class="px-2.5 py-1 rounded-lg bg-[#A8382B] hover:bg-[#82271D] text-white text-[11px] font-bold transition flex items-center gap-1 cursor-pointer shadow-sm"
    >
      + Adicionar Case
    </button>
  </div>

  <!-- Quick Navigation Pills to jump to any case card -->
  <div id="cases-pills-container" class="flex items-center gap-1.5 overflow-x-auto pb-1 no-scrollbar">
    <span class="text-[10px] text-[#8A827B] uppercase font-bold flex-shrink-0">Pular para:</span>
    {casesList.map((item, idx) => (
      <button
        type="button"
        class="scroll-to-card-btn px-2.5 py-1 rounded-lg bg-[#24201C] hover:bg-[#2D2824] text-[11px] font-semibold text-[#FAF8F5] border border-[#2D2824] hover:border-[#A8382B] transition cursor-pointer flex-shrink-0"
        data-target={`card-case-${idx}`}
      >
        Caso {idx + 1}
      </button>
    ))}
  </div>

  <div id="cases-list-container" class="space-y-4">
    {casesList.map((item, idx) => (
      <div id={`card-case-${idx}`} class="case-card-item p-3.5 rounded-2xl bg-[#24201C] border border-[#2D2824] space-y-2.5 transition-all scroll-mt-2" data-path={item.path}>
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-white truncate max-w-[200px] case-card-brand-display">{item.data.brand || "Novo Case"}</span>
          <div class="flex items-center gap-2">
            <span class="text-[10px] px-2 py-0.5 rounded bg-[#1B1815] text-[#C28D3F] border border-[#2D2824] font-semibold case-card-stats-display">{item.data.stats || "+0%"}</span>
            <button
              type="button"
              class="btn-delete-case p-1 rounded-lg text-[#8A827B] hover:text-red-400 hover:bg-red-950 transition cursor-pointer"
              data-path={item.path}
              title="Excluir este case"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
            </button>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block text-[10px] font-bold text-[#8A827B] mb-1">Marca / Produto</label>
            <input
              type="text"
              class="case-input w-full px-2.5 py-1.5 rounded-lg bg-[#1B1815] border border-[#2D2824] focus:border-[#A8382B] text-xs text-white"
              data-path={item.path}
              data-field="brand"
              value={item.data.brand}
              placeholder="Ex: Lumière Cosméticos"
            />
          </div>
          <div>
            <label class="block text-[10px] font-bold text-[#8A827B] mb-1">Métrica Resumida (Badge)</label>
            <input
              type="text"
              class="case-input w-full px-2.5 py-1.5 rounded-lg bg-[#1B1815] border border-[#2D2824] focus:border-[#A8382B] text-xs text-white"
              data-path={item.path}
              data-field="stats"
              value={item.data.stats}
              placeholder="Ex: 450k views · Conversão +42%"
            />
          </div>
        </div>
        <div>
          <label class="block text-[10px] font-bold text-[#8A827B] mb-1">Título do Criativo / Case</label>
          <input
            type="text"
            class="case-input w-full px-2.5 py-1.5 rounded-lg bg-[#1B1815] border border-[#2D2824] focus:border-[#A8382B] text-xs text-white"
            data-path={item.path}
            data-field="title"
            value={item.data.title}
          />
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block text-[10px] font-bold text-[#8A827B] mb-1">Número Destaque</label>
            <input
              type="text"
              class="case-input w-full px-2.5 py-1.5 rounded-lg bg-[#1B1815] border border-[#2D2824] focus:border-[#A8382B] text-xs text-white"
              data-path={item.path}
              data-field="highlightMetric"
              value={item.data.highlightMetric}
            />
          </div>
          <div>
            <label class="block text-[10px] font-bold text-[#8A827B] mb-1">Descrição Métrica</label>
            <input
              type="text"
              class="case-input w-full px-2.5 py-1.5 rounded-lg bg-[#1B1815] border border-[#2D2824] focus:border-[#A8382B] text-xs text-white"
              data-path={item.path}
              data-field="metricLabel"
              value={item.data.metricLabel}
            />
          </div>
        </div>
        <div>
          <label class="block text-[10px] font-bold text-[#8A827B] mb-1">Depoimento da Marca</label>
          <textarea
            rows="2"
            class="case-input w-full px-2.5 py-1.5 rounded-lg bg-[#1B1815] border border-[#2D2824] focus:border-[#A8382B] text-xs text-white resize-none"
            data-path={item.path}
            data-field="quote"
          >{item.data.quote}</textarea>
        </div>
        <div>
          <label class="block text-[10px] font-bold text-[#8A827B] mb-1">Autor do Depoimento</label>
          <input
            type="text"
            class="case-input w-full px-2.5 py-1.5 rounded-lg bg-[#1B1815] border border-[#2D2824] focus:border-[#A8382B] text-xs text-white"
            data-path={item.path}
            data-field="author"
            value={item.data.author}
          />
        </div>
        <div>
          <label class="block text-[10px] font-bold text-[#8A827B] mb-1">Vídeo (Link Google Drive ou YouTube)</label>
          <input
            type="text"
            class="case-input w-full px-2.5 py-1.5 rounded-lg bg-[#1B1815] border border-[#2D2824] focus:border-[#A8382B] text-xs text-white placeholder-[#8A827B]"
            data-path={item.path}
            data-field="youtubeId"
            value={item.data.youtubeId}
            placeholder="Ex: https://drive.google.com/file/d/... ou ID do YouTube"
          />
        </div>
        <div>
          <label class="block text-[10px] font-bold text-[#8A827B] mb-1">Capa / Thumbnail (Link Google Drive ou Imagem)</label>
          <input
            type="text"
            class="case-input w-full px-2.5 py-1.5 rounded-lg bg-[#1B1815] border border-[#2D2824] focus:border-[#A8382B] text-xs text-white placeholder-[#8A827B]"
            data-path={item.path}
            data-field="thumbnail"
            value={item.data.thumbnail}
            placeholder="Ex: https://drive.google.com/file/d/... ou link de imagem"
          />
        </div>
      </div>
    ))}
  </div>
</div>
