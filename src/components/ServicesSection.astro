---
import { portfolioData } from "../data/portfolioData";

const { services, creator } = portfolioData;
const whatsappLink = `https://wa.me/${creator.whatsapp}?text=${encodeURIComponent("Olá Amanda! Gostaria de consultar os pacotes e valores para criativos UGC.")}`;
---

<section
  id="servicos"
  class="py-16 sm:py-24 bg-white border-t border-[#1B1815]/10 relative overflow-hidden"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14 items-start">
      <!-- Left Column: Sticky Editorial Presentation -->
      <div class="lg:col-span-5 lg:sticky lg:top-28">
        <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-[#A8382B] mb-3">
          <span class="w-6 h-px bg-[#A8382B]"></span>
          <span data-i18n="services.badge">Soluções Sob Medida</span>
        </div>
        <h2 data-i18n="services.title" class="text-3xl sm:text-4xl md:text-5xl font-impact tracking-tight text-[#1B1815] uppercase leading-[1.08]">
          Formatos que Geram Retorno
        </h2>
        <p data-i18n="services.subtitle" class="font-cursive text-3xl sm:text-4xl text-[#57524C] mt-2 mb-6">
          do roteiro ao anúncio aprovado
        </p>

        <p data-i18n="services.desc" class="text-sm sm:text-base text-[#57524C] leading-relaxed mb-8">
          Cada projeto é desenvolvido respeitando a linguagem nativa do TikTok e
          Instagram Reels, priorizando autenticidade sobre produção engessada.
        </p>

        <!-- Highlights Card -->
        <div class="p-6 rounded-2xl bg-[#FAF8F5] border border-[#1B1815]/10 space-y-4 mb-8">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-full bg-[#A8382B] text-white flex items-center justify-center text-xs font-bold">
              ✓
            </span>
            <span data-i18n="services.h1" class="text-xs font-semibold text-[#1B1815]">
              Áudio original em alta fidelidade com microfone sem fio
            </span>
          </div>
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-full bg-[#A8382B] text-white flex items-center justify-center text-xs font-bold">
              ✓
            </span>
            <span data-i18n="services.h2" class="text-xs font-semibold text-[#1B1815]">
              Iluminação natural e ambiente residencial realista
            </span>
          </div>
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-full bg-[#A8382B] text-white flex items-center justify-center text-xs font-bold">
              ✓
            </span>
            <span data-i18n="services.h3" class="text-xs font-semibold text-[#1B1815]">
              Gravação em 4K (iPhone 16 Pro Max)
            </span>
          </div>
        </div>

        <a
          href={whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          data-i18n="services.cta"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-[#1B1815] text-[#FAF8F5] text-xs font-semibold uppercase tracking-wider hover:bg-[#A8382B] transition-colors"
        >
          <span>Consultar Pacotes & Preços</span>
          <span>→</span>
        </a>
      </div>

      <!-- Right Column: Glassmorphic Pinned Service Cards -->
      <div class="lg:col-span-7 space-y-6">
        {services.map((service) => (
          <div class="relative p-6 sm:p-8 rounded-2xl bg-[#FAF8F5] border border-[#1B1815]/10 shadow-sm hover:shadow-md transition-shadow group">
            <!-- Pin Icon decoration -->
            <div class="absolute -top-3 left-8 w-6 h-6 rounded-full bg-gradient-to-br from-[#A8382B] to-[#6b1109] shadow-md border-2 border-white flex items-center justify-center">
              <span class="w-1.5 h-1.5 rounded-full bg-white/70"></span>
            </div>

            <!-- Card Header -->
            <div class="flex items-baseline justify-between mb-3">
              <span class="text-3xl font-impact font-bold text-[#A8382B]">
                {service.step}
              </span>
              <span data-i18n="services.tag" class="text-[11px] font-semibold text-[#57524C] uppercase tracking-wider bg-white px-2.5 py-1 rounded-full border border-[#1B1815]/10">
                Formato Estratégico
              </span>
            </div>

            <h3 class="text-xl sm:text-2xl font-impact uppercase tracking-wide text-[#1B1815] mb-2 group-hover:text-[#A8382B] transition-colors">
              {service.title}
            </h3>

            <p class="text-sm text-[#57524C] leading-relaxed mb-4">
              {service.shortDesc}
            </p>

            <!-- Deliverables -->
            <div class="mb-4">
              <span data-i18n="services.includes" class="text-xs font-bold uppercase tracking-wider text-[#1B1815] block mb-2">
                O que inclui:
              </span>
              <div class="flex flex-wrap gap-2">
                {service.deliverables.map((item) => (
                  <span class="px-2.5 py-1 rounded-lg bg-white border border-[#1B1815]/10 text-xs font-medium text-[#57524C]">
                    • {item}
                  </span>
                ))}
              </div>
            </div>

            <!-- Best for -->
            <div class="pt-4 border-t border-[#1B1815]/10 text-xs text-[#57524C]">
              <span data-i18n="services.ideal" class="font-bold text-[#1B1815]">Ideal para:</span>{" "}
              {service.idealFor}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
